---
import "../styles/global.css";
import "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import { createHash } from "node:crypto";
import type { Dict } from "../i18n/en";
import { locales, deal, localeOf, localePath } from "../i18n/index";
import { pageJsonLd } from "../lib/structured-data";
import MaintenanceNotice from "../components/MaintenanceNotice.astro";

// slug = page path without locale prefix ("" for home, "market", "agents/codex" …).
// mainId = the id the skip link jumps to; pages whose <main> is built by a script name it here.
interface Props { t: Dict; slug?: string; title?: string; description?: string; privatePage?: boolean; mainId?: string }
const { t, slug = "", privatePage = false, mainId = "main" } = Astro.props;
const title = deal(t, Astro.props.title ?? t.meta.title);
const description = deal(t, Astro.props.description ?? t.meta.description);
const canonical = new URL(Astro.url.pathname, Astro.site);
const current = localeOf(t);
const indexable = !privatePage && ["", "market", "developer-api", "security", "faq", "blog", "terms", "privacy", "refund"].includes(slug.replace(/\/$/, ""));
const jsonLd = JSON.stringify(pageJsonLd({ t, slug, description, canonical, origin: Astro.site?.origin ?? canonical.origin })).replace(/</g, "\\u003c");
// JSON-LD is inert data but still participates in the emitted per-page policy.
if (indexable) Astro.csp?.insertScriptHash(`sha256-${createHash("sha256").update(jsonLd).digest("base64")}`);
// Authorize the marker's exact emitted bytes. Astro does not process is:inline
// scripts automatically, and inserts its CSP meta at the end of the head.
const enableJsScript = 'document.documentElement.classList.add("js");';
Astro.csp?.insertScriptHash(`sha256-${createHash("sha256").update(enableJsScript).digest("base64")}`);
---
<!doctype html>
<html lang={t.meta.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="referrer" content="no-referrer" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable ? <meta name="robots" content="noindex, nofollow, noarchive" /> : <>
      <link rel="canonical" href={canonical} />
      {locales.map((l) => <link rel="alternate" hreflang={l.hreflang} href={new URL(localePath(l, slug), Astro.site)} />)}
      <link rel="alternate" hreflang="x-default" href={new URL(localePath({ path: "/" }, slug), Astro.site)} />
      <link rel="sitemap" href="/sitemap-index.xml" />
    </>}
    <meta property="og:site_name" content="Fells" />
    <meta property="og:locale" content={current.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og.png", Astro.site)} />
    {!privatePage && <meta property="og:url" content={canonical} />}
    {indexable && <script type="application/ld+json" set:html={jsonLd} />}
    <meta name="theme-color" content="#090b0e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  </head>
  <body>
    <!-- Run after Astro's CSP meta, before any visible body content can paint. -->
    <script is:inline set:html={enableJsScript} />
    <a class="skip" href={`#${mainId}`}>{t.ui.skip}</a>
    <MaintenanceNotice locale={current.code} />
    <slot />
    <script>
      import "../scripts/reveal";
      // Arrow keys move between tabs, as the tablist role promises.
      addEventListener("keydown", (e) => {
        const tab = (e.target as HTMLElement).closest?.<HTMLElement>('[role="tab"]');
        const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
        if (!tab || (!step && e.key !== "Home" && e.key !== "End")) return;
        const tabs = [...tab.closest('[role="tablist"]')!.querySelectorAll<HTMLElement>('[role="tab"]')].filter((x) => x.offsetParent);
        const next = e.key === "Home" ? tabs[0] : e.key === "End" ? tabs[tabs.length - 1] : tabs[(tabs.indexOf(tab) + step! + tabs.length) % tabs.length];
        e.preventDefault();
        next.focus();
        next.click();
      });
    </script>
  </body>
</html>
