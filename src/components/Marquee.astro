---
import { agentMarks } from "../data/icons";
import type { Dict } from "../i18n/en";
interface Props { t: Dict }
const { marquee } = Astro.props.t;
// Same order as marquee.items in every locale.
const marks = [agentMarks.claude, undefined, agentMarks.opencode];
---
<section class="marquee" aria-label={marquee.label}>
  <p class="label">{marquee.label}</p>
  <div class="track-wrap">
    <ul class="track">
      {[...marquee.items, ...marquee.items].map((item, i) => {
        const mk = marks[i % marquee.items.length];
        return (
          <li aria-hidden={i >= marquee.items.length ? "true" : undefined}>
            {mk && <span class="aimk" style={`--hue:${mk.hue};--mk:22px`} aria-hidden="true"><Fragment set:html={mk.svg} /></span>}
            {item}
          </li>
        );
      })}
    </ul>
  </div>
</section>
<style>
  .marquee { padding: clamp(40px, 6vw, 72px) 0 40px; border-top: 1px solid var(--line); }
  .label { text-align: center; color: var(--dim); font-size: 13px; margin: 0 0 18px; }
  .track-wrap { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent); }
  .track { list-style: none; margin: 0; padding: 0; display: flex; gap: 14px; width: max-content; animation: slide 40s linear infinite; }
  .track-wrap:hover .track { animation-play-state: paused; }
  li {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 8px 18px 8px 10px; border-radius: 999px; border: 1px solid var(--line); background: var(--panel);
    color: var(--muted); font-size: 14px; white-space: nowrap;
  }
  @keyframes slide { to { transform: translateX(calc(-50% - 7px)); } }
</style>
