---
import { agentMarks } from "../data/icons";
import type { Dict } from "../i18n/en";
interface Props { t: Dict }
const { marquee } = Astro.props.t;
const marks = [agentMarks.claude, undefined, agentMarks.opencode];
---
<section class="marquee" aria-label={marquee.label}>
  <div class="wrap">
    <p class="label">{marquee.label}</p>
    <ul class="tools" role="list">
      {marquee.items.map((item, i) => {
        const mark = marks[i];
        return <li>{mark && <span class="aimk" style={`--hue:${mark.hue};--mk:22px`} aria-hidden="true"><Fragment set:html={mark.svg} /></span>}{item}</li>;
      })}
    </ul>
  </div>
</section>
<style>
  .marquee { padding: clamp(18px, 3vw, 28px) 0; border-top: 1px solid var(--line); }
  .label { margin: 0 0 10px; text-align: center; color: var(--dim); font-size: 13px; }
  .tools { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 14px; }
  li { display: inline-flex; align-items: center; gap: 8px; max-width: 100%; padding: 7px 13px 7px 9px; border: 1px solid var(--line); border-radius: 999px; background: var(--panel); color: var(--muted); font-size: 14px; }
</style>
