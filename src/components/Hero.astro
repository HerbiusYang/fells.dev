---
import { agentMarks } from "../data/icons";
import { publicPurchaseCopy } from "../i18n/purchase-entry";
import type { Dict } from "../i18n/en";
import { deal } from "../i18n/index";
interface Props { t: Dict }
const { t } = Astro.props;
const { hero } = t;
const code = t.meta.lang.toLowerCase();
const purchase = publicPurchaseCopy(code);
const catalogCopy = {kicker:purchase.title,body:purchase.body,action:purchase.action};

---
<section class="hero" id="top">
  <div class="contours" aria-hidden="true"></div>
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap center">
    <button type="button" class="announce" data-open-customer-support data-purchase-market>
      <span class="stars" aria-hidden="true"></span>
      <span class="an-ic" aria-hidden="true"><Fragment set:html={agentMarks.claude.svg} /></span>
      <span class="an-txt"><b>{catalogCopy.kicker}</b><small>{catalogCopy.body}</small></span>
      <span class="an-chev" aria-hidden="true">›</span>
    </button>
    <h1>
      <span class="a">{hero.titleA}</span>
      <span class="grad">{deal(t, hero.titleB)}</span>
    </h1>
    <ul class="chips">{hero.chips.map((c) => <li>{c}</li>)}</ul>
    <p class="sub">{hero.sub}</p>
    <div class="ctas">
      <button type="button" class="btn btn-primary" data-open-customer-support data-purchase-market>{catalogCopy.action}</button>
      <a class="btn btn-ghost" href="#plans">{hero.secondary}</a>
    </div>


  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; padding: clamp(56px, 9vw, 110px) 0 0; overflow: hidden; }
  .glow { position: absolute; z-index: -1; left: 50%; top: 30%; width: 1100px; height: 700px; translate: -50% 0; background: radial-gradient(closest-side, rgba(224,122,85,.22), transparent 70%), radial-gradient(closest-side at 70% 60%, rgba(124,140,255,.14), transparent 70%); filter: blur(20px); }
  .center { text-align: center; display: flex; flex-direction: column; align-items: center; }
  h1 { margin: 0; font-weight: 700; letter-spacing: -.045em; line-height: 1.02; font-size: clamp(40px, 7.4vw, 92px); display: flex; flex-direction: column; align-items: center; text-wrap: balance; }
  .a { font-weight: 450; letter-spacing: -.05em; font-size: .82em; color: #d9dee5; }
  .grad { background: linear-gradient(100deg, var(--ember-2) 10%, #ffd9c4 45%, var(--violet) 95%); -webkit-background-clip: text; background-clip: text; color: transparent; padding-bottom: .06em; }
  .chips { list-style: none; padding: 0; margin: 26px 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 22px; color: var(--muted); font-size: 14px; }
  .chips li { display: inline-flex; align-items: center; gap: 8px; }
  .chips li::before { content: "✓"; font-size: 11px; width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; background: var(--panel-2); border: 1px solid var(--line-2); color: var(--moss); }
  .announce { position: relative; overflow: hidden; margin-bottom: 36px; width: min(620px, 100%); display: flex; align-items: center; gap: 14px; padding: 14px 18px; border-radius: 16px; text-align: left; color: inherit; font: inherit; cursor: pointer; background: #050608; border: 1px solid var(--line-2); box-shadow: 0 20px 50px -20px rgba(0,0,0,.9), inset 0 1px 0 rgba(255,255,255,.06); transition: border-color .3s, transform .3s var(--ease); }
  .announce:hover { border-color: rgba(243,163,127,.45); transform: translateY(-2px); }
  .stars { position: absolute; inset: 0; pointer-events: none; opacity: .6; background-image: radial-gradient(1px 1px at 12% 30%, #fff, transparent), radial-gradient(1px 1px at 34% 80%, #fff, transparent), radial-gradient(1px 1px at 58% 20%, #fff, transparent), radial-gradient(1px 1px at 76% 66%, #fff, transparent), radial-gradient(1.5px 1.5px at 90% 28%, #fff, transparent); animation: twinkle 4s ease-in-out infinite alternate; }
  @keyframes twinkle { to { opacity: .25; } }
  .an-ic { position: relative; flex: none; width: 38px; height: 38px; border-radius: 11px; display: grid; place-items: center; background: #b8604a; color: #fff; font-size: 18px; }
  .an-txt { position: relative; display: flex; flex-direction: column; flex: 1; min-width: 0; line-height: 1.35; }
  .an-txt b { font-size: 15px; font-weight: 600; }
  .an-txt small { font-size: 13px; color: var(--muted); }
  .an-chev { position: relative; flex: none; font-size: 22px; line-height: 1; color: var(--muted); transition: transform .3s var(--ease), color .3s; }
  .announce:hover .an-chev { transform: translateX(3px); color: var(--ember-2); }
  .sub { color: var(--muted); font-size: clamp(15px, 1.6vw, 17px); max-width: 620px; margin: 32px 0 0; text-wrap: pretty; }
  .ctas { display: flex; gap: 12px; margin-top: 26px; flex-wrap: wrap; justify-content: center; }

  /* Product preview: terminal on the left, the account's usage log on the right. */
  .preview { width: min(1000px, 100%); margin-top: clamp(44px, 6vw, 72px); display: grid; grid-template-columns: 0.95fr 1.05fr; text-align: left; border-radius: 20px; border: 1px solid var(--line-2); background: linear-gradient(180deg, #0d1015, #090b0e); box-shadow: 0 40px 90px -40px rgba(0,0,0,.95), 0 0 0 1px rgba(255,255,255,.02) inset; overflow: hidden; animation: rise 1s var(--ease) .15s both; }
  @keyframes rise { from { opacity: 0; transform: translateY(24px); } }
  .pane { min-width: 0; }
  .pane + .pane { border-left: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 12px; height: 42px; padding: 0 16px; border-bottom: 1px solid var(--line); font-size: 12.5px; color: var(--dim); }
  .dots { display: inline-flex; gap: 6px; }
  .dots i { width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,.12); }
  .title { font-weight: 500; }
  .title.mono { margin-left: auto; font: 500 11px var(--mono); letter-spacing: .08em; }
  .live { display: inline-flex; align-items: center; gap: 8px; font: 500 12px var(--mono); color: var(--muted); }
  .live i { width: 7px; height: 7px; border-radius: 50%; background: var(--moss); box-shadow: 0 0 10px var(--moss); animation: pulse 2.4s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: .35; } }
  pre { margin: 0; padding: 18px 20px 22px; font: 13px/1.85 var(--mono); color: #cfd5dd; overflow: hidden; white-space: pre; }
  .p { color: var(--dim); }
  .s { color: var(--ember-2); }
  .ok { color: var(--moss); }
  .cur { display: inline-block; width: 8px; height: 15px; vertical-align: -2px; background: var(--text); animation: blink 1.1s steps(2, end) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th { text-align: right; padding: 10px 16px 8px; font: 500 11px var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--dim); }
  th:first-child, td:first-child { text-align: left; }
  td { padding: 9px 16px; text-align: right; font-variant-numeric: tabular-nums; color: var(--muted); border-top: 1px solid var(--line); white-space: nowrap; }
  td:first-child { color: var(--text); display: flex; align-items: center; gap: 9px; }
  td:last-child { color: var(--text); font-weight: 550; }
  tfoot td { color: var(--dim); }
  tfoot td:last-child { color: var(--moss); }

  @media (max-width: 860px) {
    .preview { grid-template-columns: 1fr; }
    .pane + .pane { border-left: 0; border-top: 1px solid var(--line); }
    .usage tbody tr:nth-child(n + 4) { display: none; }
    th:nth-child(2), td:nth-child(2) { display: none; }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 28px; }
    .announce { margin-bottom: 26px; padding: 12px 14px; gap: 12px; }
    .chips { margin-top: 20px; gap: 8px 16px; }
    .sub { margin-top: 20px; }
    .ctas { width: 100%; margin-top: 22px; }
    .ctas .btn { flex: 1 1 100%; height: 50px; }
    .preview { margin-top: 36px; border-radius: 16px; }
    pre { font-size: 12px; padding: 14px 16px 18px; }
    th, td { padding-left: 12px; padding-right: 12px; }
  }
</style>
