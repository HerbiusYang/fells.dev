---
import { publicPurchaseCopy } from "../i18n/purchase-entry";
import type { Dict } from "../i18n/en";
import { deal } from "../i18n/index";
interface Props { t: Dict }
const { t } = Astro.props;
const { hero } = t;
const purchase = publicPurchaseCopy(t.meta.lang.toLowerCase());
---
<section class="hero" id="top">
  <div class="contours" aria-hidden="true"></div>
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap hero-layout">
    <div class="hero-copy">
      <h1>
        <span class="a">{hero.titleA}</span>
        <span class="grad">{deal(t, hero.titleB)}</span>
      </h1>
      <p class="sub">{hero.sub}</p>
      <div class="ctas">
        <button type="button" class="btn btn-primary" data-open-customer-support data-purchase-market>{purchase.action}</button>
        <a class="btn btn-ghost" href="#plans">{hero.secondary}</a>
      </div>
      <ul class="chips">{hero.chips.map((c) => <li>{c}</li>)}</ul>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; padding: clamp(50px, 7vw, 102px) 0 clamp(50px, 8vw, 104px); overflow: clip; }
  .glow { position: absolute; z-index: -1; inset: 0; background: radial-gradient(ellipse at 24% 66%, rgba(224,122,85,.16), transparent 52%), radial-gradient(ellipse at 68% 68%, rgba(124,140,255,.11), transparent 50%); }
  .hero-layout { display: grid; justify-items: center; text-align: center; }
  .hero-copy { min-width: 0; }
  h1 { display: grid; row-gap: clamp(8px, 1.15vw, 17px); margin: 0; font-weight: 700; letter-spacing: -.045em; line-height: 1.05; font-size: clamp(42px, 6.2vw, 88px); text-wrap: balance; }
  h1 > span { display: block; }
  .a { font-weight: 450; letter-spacing: -.05em; font-size: .82em; color: #d9dee5; }
  .grad { background: linear-gradient(100deg, var(--ember-2) 10%, #ffd9c4 45%, var(--violet) 95%); -webkit-background-clip: text; background-clip: text; color: transparent; padding-bottom: .07em; }
  .sub { color: var(--muted); font-size: clamp(15px, 1.6vw, 17px); max-width: 58ch; margin: 20px auto 0; text-wrap: pretty; }
  .ctas { display: flex; gap: 10px 12px; margin-top: 24px; flex-wrap: wrap; justify-content: center; }
  .ctas .btn { min-height: 48px; height: auto; padding-block: 10px; white-space: normal; text-align: center; }
  .chips { list-style: none; padding: 0; margin: 24px 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 18px; color: var(--muted); font-size: 13px; }
  .chips li { display: inline-flex; align-items: center; gap: 6px; }
  .chips li::before { content: "✓"; font-size: 10px; width: 16px; height: 16px; flex: none; border-radius: 50%; display: grid; place-items: center; background: var(--panel); border: 1px solid var(--line-2); color: var(--moss); }
  @media (max-width: 520px) {
    .hero { padding-top: 32px; padding-bottom: 40px; }
    h1 { font-size: clamp(32px, 10vw, 50px); }
    .sub { margin-top: 16px; }
    .ctas { margin-top: 20px; }
    .ctas .btn { flex-basis: 100%; }
    .chips { margin-top: 18px; }
  }
</style>
