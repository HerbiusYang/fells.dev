---
import { agentMarks } from "../data/icons";
import type { Dict } from "../i18n/en";
import { deal } from "../i18n/index";
interface Props { t: Dict }
const { t } = Astro.props;
const { hero } = t;
const code = t.meta.lang.toLowerCase();
const catalogCopy = code.startsWith("zh-hant")
  ? { kicker: "線上客服購買", body: "聯絡客服確認可購買的服務與付款安排。", action: "聯絡客服購買" }
  : code.startsWith("zh")
    ? { kicker: "在线客服购买", body: "联系客服确认可购买的服务和付款安排。", action: "联系客服购买" }
    : code.startsWith("ja")
      ? { kicker: "オンラインサポート購入", body: "購入できるサービスとお支払い方法はサポートにお問い合わせください。", action: "サポートに購入を相談" }
      : code.startsWith("ko")
        ? { kicker: "온라인 고객 지원 구매", body: "구매 가능한 서비스와 결제 방법은 고객 지원에 문의해 주세요.", action: "고객 지원에 구매 문의" }
        : code.startsWith("es")
          ? { kicker: "Compra con atención al cliente", body: "Consulta los servicios disponibles y las opciones de pago con atención al cliente.", action: "Contactar para comprar" }
          : { kicker: "Purchase through online support", body: "Contact support to confirm available services and payment arrangements.", action: "Contact support to purchase" };
const orbs = [
  { g: "claude", hue: "#e07a55", x: "8%", y: "18%", s: 120 },
  { g: "codex", hue: "#7c8cff", x: "86%", y: "12%", s: 150 },
  { g: "opencode", hue: "#9aa4b2", x: "17%", y: "3%", s: 64 },
  { g: "kimi", hue: "#5fd0c4", x: "74%", y: "40%", s: 80 },
  { g: "grok", hue: "#c9ccd3", x: "4%", y: "52%", s: 92 },
  { g: "+", hue: "#c9a7ff", x: "92%", y: "58%", s: 56 },
];
---
<section class="hero" id="top">
  <div class="contours" aria-hidden="true"></div>
  <div class="glow" aria-hidden="true"></div>
  <div class="orbs" aria-hidden="true" data-orbs>
    {orbs.map((o, i) => (
      <span class="orb" style={`--x:${o.x};--y:${o.y};--s:${o.s}px;--hue:${o.hue};--d:${(i * 0.43).toFixed(2)}s;--depth:${(i % 3) + 1}`}>
        <span class="orb-g"><Fragment set:html={agentMarks[o.g]?.svg ?? o.g} /></span>
      </span>
    ))}
  </div>
  <div class="wrap center">
    <button class="announce" type="button" data-open-customer-support>
      <span class="stars" aria-hidden="true"></span>
      <span class="an-ic" aria-hidden="true"><Fragment set:html={agentMarks.claude.svg} /></span>
      <span class="an-txt"><b>{catalogCopy.kicker}</b><small>{catalogCopy.body}</small></span>
      <span class="an-badge">{catalogCopy.action}</span>
      <span class="an-cta">{catalogCopy.action} <span aria-hidden="true">›</span></span>
    </button>
    <h1>
      <span class="a">{hero.titleA}</span>
      <span class="grad">{deal(t, hero.titleB)}</span>
    </h1>
    <ul class="chips">{hero.chips.map((c) => <li>{c}</li>)}</ul>
    <p class="sub">{hero.sub}</p>
    <div class="ctas">
      <button class="btn btn-primary" type="button" data-open-customer-support>{catalogCopy.action}</button>
      <a class="btn btn-ghost" href="#plans">{hero.secondary}</a>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; padding: clamp(56px, 9vw, 110px) 0 clamp(60px, 8vw, 100px); overflow: hidden; }
  .glow { position: absolute; z-index: -1; left: 50%; top: 52%; width: 1100px; height: 700px; translate: -50% 0; background: radial-gradient(closest-side, rgba(224,122,85,.22), transparent 70%), radial-gradient(closest-side at 70% 60%, rgba(124,140,255,.14), transparent 70%); filter: blur(20px); }
  .orbs { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .orb { position: absolute; left: var(--x); top: var(--y); width: var(--s); height: var(--s); border-radius: 50%; display: grid; place-items: center; background: radial-gradient(circle at 30% 25%, rgba(255,255,255,.22), transparent 42%), radial-gradient(circle at 70% 80%, color-mix(in oklab, var(--hue) 30%, transparent), transparent 60%), rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.09); box-shadow: inset 0 -12px 30px rgba(0,0,0,.35), 0 30px 60px -30px rgba(0,0,0,.9); backdrop-filter: blur(6px); translate: calc(var(--mx, 0) * var(--depth) * 10px) calc(var(--my, 0) * var(--depth) * 10px); animation: bob 7s ease-in-out var(--d) infinite; transition: translate .8s var(--ease); }
  .orb-g { font-size: calc(var(--s) * .34); font-weight: 700; color: var(--hue); opacity: .85; filter: drop-shadow(0 0 12px var(--hue)); }
  @keyframes bob { 50% { transform: translateY(-14px); } }
  @media (max-width: 900px) { .orbs { display: none; } }
  .center { text-align: center; display: flex; flex-direction: column; align-items: center; }
  h1 { margin: 0; font-weight: 700; letter-spacing: -.045em; line-height: 1.02; font-size: clamp(40px, 7.4vw, 92px); display: flex; flex-direction: column; align-items: center; text-wrap: balance; }
  .a { font-weight: 450; letter-spacing: -.05em; font-size: .82em; color: #d9dee5; }
  .grad { background: linear-gradient(100deg, var(--ember-2) 10%, #ffd9c4 45%, var(--violet) 95%); -webkit-background-clip: text; background-clip: text; color: transparent; padding-bottom: .06em; }
  .chips { list-style: none; padding: 0; margin: 26px 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 22px; color: var(--muted); font-size: 14px; }
  .chips li { display: inline-flex; align-items: center; gap: 8px; }
  .chips li::before { content: "✓"; font-size: 11px; width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; background: var(--panel-2); border: 1px solid var(--line-2); color: var(--moss); }
  .announce { position: relative; overflow: hidden; margin-bottom: 36px; width: min(620px, 100%); display: flex; align-items: center; gap: 14px; padding: 14px 18px; border-radius: 16px; text-align: left; color: inherit; font: inherit; cursor: pointer; background: #050608; border: 1px solid var(--line-2); box-shadow: 0 20px 50px -20px rgba(0,0,0,.9), inset 0 1px 0 rgba(255,255,255,.06); transition: border-color .3s, transform .3s var(--ease); }
  .announce:hover { border-color: rgba(243,163,127,.45); transform: translateY(-2px); }
  .stars { position: absolute; inset: 0; pointer-events: none; opacity: .6; background-image: radial-gradient(1px 1px at 12% 30%, #fff, transparent), radial-gradient(1px 1px at 34% 80%, #fff, transparent), radial-gradient(1px 1px at 58% 20%, #fff, transparent), radial-gradient(1px 1px at 76% 66%, #fff, transparent), radial-gradient(1.5px 1.5px at 90% 28%, #fff, transparent); animation: twinkle 4s ease-in-out infinite alternate; }
  @keyframes twinkle { to { opacity: .25; } }
  .an-ic { position: relative; flex: none; width: 38px; height: 38px; border-radius: 11px; display: grid; place-items: center; background: #b8604a; color: #fff; font-size: 18px; }
  .an-txt { position: relative; display: flex; flex-direction: column; min-width: 0; line-height: 1.35; }
  .an-txt b { font-size: 15px; font-weight: 600; }
  .an-txt small { font-size: 13px; color: var(--muted); }
  .an-badge { position: relative; margin-left: auto; flex: none; font-size: 12px; padding: 5px 11px; border-radius: 999px; border: 1px solid var(--line-2); background: rgba(255,255,255,.05); white-space: nowrap; }
  .an-cta { position: relative; flex: none; font-size: 13.5px; font-weight: 600; white-space: nowrap; }
  .sub { color: var(--muted); font-size: clamp(15px, 1.6vw, 17px); max-width: 620px; margin: 32px 0 0; text-wrap: pretty; }
  .ctas { display: flex; gap: 12px; margin-top: 26px; flex-wrap: wrap; justify-content: center; }
  @media (max-width: 640px) { .hero { padding-top: 28px; padding-bottom: 48px; } .announce { margin-bottom: 26px; padding: 12px 14px; gap: 12px; } .an-cta { display: none; } .an-badge { align-self: flex-start; } .chips { margin-top: 20px; gap: 8px 16px; } .sub { margin-top: 20px; } .ctas { width: 100%; margin-top: 22px; } .ctas .btn { flex: 1 1 100%; height: 50px; } }
</style>

<script>
  const orbs = document.querySelector<HTMLElement>("[data-orbs]");
  if (orbs && matchMedia("(pointer: fine) and (prefers-reduced-motion: no-preference)").matches) {
    let frame = 0;
    addEventListener("pointermove", (e) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        orbs.style.setProperty("--mx", ((e.clientX / innerWidth - 0.5) * 2).toFixed(3));
        orbs.style.setProperty("--my", ((e.clientY / innerHeight - 0.5) * 2).toFixed(3));
      });
    }, { passive: true });
  }
</script>
