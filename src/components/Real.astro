---
import type { Dict } from "../i18n/en";
import { deal } from "../i18n/index";
interface Props { t: Dict }
const { t } = Astro.props;
const { real: r } = t;
const lang = t.meta.lang.toLowerCase();
const action = lang.startsWith("zh-hant") ? "聯絡客服購買" : lang.startsWith("zh") ? "联系客服购买" : lang.startsWith("ja") ? "サポートに購入を相談" : lang.startsWith("ko") ? "고객 지원에 구매 문의" : lang.startsWith("es") ? "Contactar para comprar" : "Contact support to purchase";
---
<section class="section real" id="real">
  <div class="wrap">
    <div class="reveal">
      <span class="kicker">{r.kicker}</span>
      <h2 class="h2">{r.title}</h2>
      <p class="lead">{r.sub}</p>
    </div>
    <ul class="grid reveal">
      {r.items.map((it) => (
        <li>
          <h3>{deal(t, it.title)}</h3>
          <p>{deal(t, it.body)}</p>
          {it.check && <p class="check"><b>{r.checkLabel}</b>{it.check}</p>}
        </li>
      ))}
    </ul>
    <button class="btn btn-primary cta reveal" type="button" data-open-customer-support>{action}</button>
  </div>
</section>
<style>
  .real { padding-top: 40px; }
  .grid { list-style: none; padding: 0; margin: 48px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  li { display: flex; flex-direction: column; padding: 24px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--panel); }
  h3 { margin: 0; font-size: 18px; font-weight: 600; letter-spacing: -0.01em; }
  li p { margin: 8px 0 0; color: var(--muted); font-size: 14.5px; }
  li .check { margin-top: auto; padding-top: 16px; font-size: 13.5px; color: var(--text); }
  .check b { display: block; margin-bottom: 2px; font: 500 12px var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--moss); }
  .cta { margin-top: 28px; }
  @media (max-width: 960px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } .cta { width: 100%; } }
</style>
