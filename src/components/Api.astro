---
import type { Dict } from "../i18n/en";
import { link } from "../i18n/index";
import { publicFacts } from "../i18n/public-facts";
interface Props { t: Dict }
const { t } = Astro.props;
const a = t.api, facts = publicFacts(t.meta.lang);
---
<section class="section" id="api">
  <div class="wrap">
    <div class="reveal"><span class="kicker">{a.kicker}</span><h2 class="h2">{facts.apiTitle}</h2><p class="lead">{facts.apiBody}</p></div>
    <div class="grid">
      <article class="guide reveal" data-public-api-guide>
        <h3>{facts.setupTitle}</h3><p>{facts.setupBody}</p>
        <a class="btn btn-primary" href={`${link(t, "app")}#/api`}>{facts.accountGuide} →</a>
      </article>
      <article class="guide reveal"><h3>{facts.modelTitle}</h3><p>{facts.modelBody}</p><a class="btn btn-ghost" href={link(t, "market")}>{t.nav.market} →</a></article>
    </div>
  </div>
</section>
<style>
  #api { border-top: 1px solid var(--line); }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 40px; }
  .guide { min-width: 0; padding: clamp(22px, 4vw, 36px); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--panel); }
  h3 { margin: 0 0 14px; font-size: 22px; line-height: 1.35; }
  p { color: var(--muted); line-height: 1.8; }
  .btn { margin-top: 16px; white-space: normal; text-align: center; }
  @media(max-width: 760px) { .grid { grid-template-columns: 1fr; } }
</style>
