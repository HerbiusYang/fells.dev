---
import type { Dict } from "../i18n/en";
import { site } from "../site";
import { publicCatalogWordsOf } from "../i18n/public-catalog";
interface Props { t: Dict; kind: "models" | "token_plans" | "subscriptions" }
const { t, kind } = Astro.props;
const words = publicCatalogWordsOf(t.meta.lang);
---
<div class="public-catalog" data-public-catalog data-kind={kind} data-language={t.meta.lang} aria-busy="false">
  <div data-public-catalog-content><p class="public-catalog-status" role="status">{words.accountNote}</p></div>
  <noscript><p class="public-catalog-status">{words.noJS} <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p></noscript>
  <div class="public-catalog-footer"><p>{words.accountNote}</p><button type="button" class="btn btn-ghost" data-open-customer-support data-purchase-market>{words.account} →</button></div>
</div>
<script>
  import "../scripts/public-catalog";
</script>
<style is:global>
  .public-catalog { min-width: 0; }
  .public-catalog-status { padding: 28px; border: 1px solid var(--line-2); border-radius: 18px; color: var(--muted); line-height: 1.7; }
  .public-catalog-status .btn { margin-top: 12px; }
  .public-catalog-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 16px; }
  .public-product { display: flex; flex-direction: column; min-width: 0; padding: clamp(20px, 3vw, 28px); border: 1px solid var(--line-2); border-radius: 20px; background: linear-gradient(155deg, #15171d, #0b0d11); }
  .public-product h3 { margin: 12px 0 0; font-size: 21px; line-height: 1.35; overflow-wrap: anywhere; }
  .public-product-status { align-self: start; padding: 4px 9px; border: 1px solid var(--line-2); border-radius: 999px; font-size: 12px; color: var(--moss); }
  .public-product[data-status="sold_out"] .public-product-status { color: var(--muted); }
  .public-product[data-status="not_open"] .public-product-status { color: var(--muted); border-style: dashed; }
  .public-product[data-status="not_open"] .public-product-price strong, .public-product[data-status="sold_out"] .public-product-price strong { color: var(--muted); }
  .public-product .btn[disabled] { opacity: .6; cursor: not-allowed; }
  .public-product-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px; margin: 20px 0; }
  .public-product-price strong { font-size: clamp(30px, 4vw, 40px); letter-spacing: -.035em; line-height: 1.15; overflow-wrap: anywhere; }
  .public-product-price small, .public-product-note { color: var(--muted); font-size: 13px; line-height: 1.65; }
  .public-product dl { display: grid; gap: 12px; margin: 0 0 20px; }
  .public-product dl div { display: grid; gap: 5px; }
  .public-product dt { color: var(--muted); font-size: 13px; }
  .public-product dd { margin: 0; font-size: 22px; font-weight: 650; color: var(--moss); overflow-wrap: anywhere; }
  .public-product .btn { margin-top: auto; white-space: normal; text-align: center; }
  .public-catalog-note { margin-top: 14px; font-size: 13px; color: var(--muted); line-height: 1.7; }
  .public-catalog-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-top: 20px; }
  .public-catalog-footer p { flex: 1 1 240px; margin: 0; font-size: 13px; color: var(--muted); line-height: 1.7; }
  .pm { overflow: hidden; border: 1px solid var(--line-2); border-radius: 20px; background: linear-gradient(180deg, rgba(255,255,255,.035), rgba(255,255,255,.01) 140px); }
  .pm-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; padding: 14px 22px; border-bottom: 1px solid var(--line); font-size: 13px; }
  .pm-legend { display: inline-flex; align-items: baseline; gap: 14px; color: var(--muted); }
  .pm-legend b { color: var(--text); font-weight: 600; }
  .pm-legend s { color: var(--dim); }
  .pm-unit { margin-left: auto; font: 500 11.5px var(--mono); letter-spacing: .06em; color: var(--dim); }
  .pm-table { width: 100%; table-layout: fixed; border-collapse: collapse; font-size: 14px; text-align: left; }
  .pm-col { width: 168px; }
  .pm-table th, .pm-table td { padding-left: 22px; padding-right: 22px; font-weight: 400; vertical-align: middle; }
  .pm-table thead th { padding-top: 12px; padding-bottom: 12px; font: 500 11px var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--dim); }
  .pm-table thead th + th, .pm-table td { text-align: right; }
  .pm-group th { padding-top: 22px; padding-bottom: 8px; border-top: 1px solid var(--line); font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .pm-group span { margin-left: 8px; font: 500 11px var(--mono); color: var(--dim); }
  .pm-group + .pm-model { border-top: 0; }
  .pm-model { border-top: 1px solid var(--line); transition: background .2s; }
  .pm-model:hover { background: rgba(255,255,255,.025); }
  .pm-table .pm-row > * { padding-top: 16px; padding-bottom: 16px; }
  .pm-table .pm-row:has(+ .pm-tier) > * { padding-bottom: 8px; }
  .pm-name { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; font-size: 15px; font-weight: 600; color: var(--text); overflow-wrap: anywhere; }
  .pm-id { display: block; margin-top: 3px; font: 12px var(--mono); color: var(--dim); overflow-wrap: anywhere; }
  .pm-tag { padding: 1px 8px; border: 1px solid var(--line-2); border-radius: 999px; font-size: 11.5px; font-weight: 500; color: var(--muted); white-space: nowrap; }
  .pm-tag[data-model-discount] { border-color: rgba(134,214,173,.32); background: rgba(134,214,173,.08); color: var(--moss); }
  .pm-extra { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; font-size: 12px; color: var(--muted); }
  .pm-price { display: inline-flex; flex-direction: row-reverse; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; font-variant-numeric: tabular-nums; }
  .pm-price b { font-size: 15px; font-weight: 600; color: var(--text); white-space: nowrap; }
  .pm-price s { font-size: 12.5px; color: var(--dim); white-space: nowrap; }
  .pm-extra .pm-price b { font-size: 12px; font-weight: 500; }
  .pm-extra .pm-price s { font-size: 11.5px; }
  .pm-table .pm-tier > * { padding-top: 0; padding-bottom: 14px; }
  .pm-tier th { padding-left: 38px; font-size: 12.5px; color: var(--dim); position: relative; }
  .pm-tier th::before { content: ""; position: absolute; left: 24px; top: -4px; width: 8px; height: 12px; border-left: 1px solid var(--line-2); border-bottom: 1px solid var(--line-2); border-bottom-left-radius: 4px; }
  .pm-tier .pm-price b { font-size: 13.5px; font-weight: 500; color: var(--muted); }
  .pm-tier .pm-price s { font-size: 12px; }
  .pm-notes { display: grid; gap: 6px; padding: 14px 22px 16px; border-top: 1px solid var(--line); font-size: 12.5px; line-height: 1.65; color: var(--dim); }
  .pm-notes p { margin: 0; }
  .pm-notes b { margin-right: 4px; font-weight: 600; color: var(--muted); }
  @media (max-width: 760px) { .pm-col { width: 128px; } .pm-table th, .pm-table td { padding-left: 16px; padding-right: 16px; } .pm-bar, .pm-notes { padding-left: 16px; padding-right: 16px; } .pm-tier th { padding-left: 32px; } .pm-tier th::before { left: 18px; } }
  @media (max-width: 520px) {
    .pm-table, .pm-table tbody, .pm-table tr, .pm-table th, .pm-table td { display: block; }
    .pm-table thead { display: none; }
    .pm-table .pm-row, .pm-table .pm-tier { display: grid; grid-template-columns: 1fr 1fr; column-gap: 12px; }
    .pm-row > th, .pm-tier > th { grid-column: 1 / -1; }
    .pm-table .pm-row > th { padding-bottom: 10px; }
    .pm-table .pm-row > td { padding-top: 0; text-align: left; }
    .pm-row > td::before { content: attr(data-label); display: block; margin-bottom: 2px; font: 500 10.5px var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--dim); }
    .pm-table .pm-tier > th { padding-bottom: 4px; }
    .pm-tier > td { text-align: left; }
    .pm-price { flex-direction: row; }
  }
  @media (max-width: 600px) { .public-catalog-footer .btn { width: 100%; white-space: normal; text-align: center; } }
</style>
