---
import type { Dict } from "../i18n/en";
import { locales, localeOf, link } from "../i18n/index";
import Logo from "./Logo.astro";
interface Props { t: Dict; slug?: string }
const { t, slug = "" } = Astro.props;
const { nav } = t;
const current = localeOf(t);
const links = [
  ["#plans", nav.market],
  ["developer-api", nav.api],
  ["workspace", nav.workspace],
  ["agents", nav.agents],
  ["security", nav.security],
  ["faq", nav.faq],
  ["blog", nav.blog],
].map(([s, label]) => ({ href: link(t, s), label, active: !s.startsWith("#") && (slug === s || slug.startsWith(s + "/")) }));
---
<header class="nav" data-nav>
  <div class="wrap row">
    <Logo href={link(t)} />
    <nav aria-label="Primary" class="links">
      {links.map((l) => <a href={l.href} aria-current={l.active ? "page" : undefined}>{l.label}</a>)}
    </nav>
    <div class="actions">
      <details class="lang" data-lang>
        <summary aria-label={nav.language}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" /></svg>
          <span class="cur">{current.label}</span>
        </summary>
        <ul class="menu">
          {locales.map((l) => (
            <li>
              <a href={l.path + slug} hreflang={l.hreflang} lang={l.hreflang} aria-current={l === current ? "true" : undefined}>
                {l.label}{l === current && <span aria-hidden="true">✓</span>}
              </a>
            </li>
          ))}
        </ul>
      </details>
      <a class="btn btn-primary sm cta" href={link(t, "app/start")}>{nav.cta}</a>
      <button type="button" class="burger" aria-label={nav.menu} aria-expanded="false" aria-controls="mobile-menu" data-burger>
        <span></span><span></span>
      </button>
    </div>
  </div>
  <div class="sheet" id="mobile-menu" data-sheet hidden>
    <nav aria-label="Mobile" class="wrap">
      {links.map((l) => <a href={l.href} aria-current={l.active ? "page" : undefined}>{l.label}</a>)}
      <a class="btn btn-primary" href={link(t, "app/start")}>{nav.cta}</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background 0.3s, border-color 0.3s;
  }
  .nav.scrolled, .nav.open {
    background: rgba(9, 11, 14, 0.78);
    border-color: var(--line);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
  }
  .row { display: flex; align-items: center; justify-content: space-between; height: 68px; gap: 24px; }
  .links { display: flex; gap: 24px; font-size: 14px; color: var(--muted); }
  .links a { transition: color 0.2s; white-space: nowrap; }
  .links a:hover, .links a[aria-current] { color: var(--text); }
  .actions { display: flex; align-items: center; gap: 10px; }

  .lang { position: relative; }
  .lang summary {
    list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 7px;
    font-size: 13px; color: var(--muted); padding: 7px 11px; border: 1px solid var(--line); border-radius: 999px;
    transition: color 0.2s, border-color 0.2s;
  }
  .lang summary::-webkit-details-marker { display: none; }
  .lang summary:hover, .lang[open] summary { color: var(--text); border-color: var(--line-2); }
  .menu {
    position: absolute; right: 0; top: calc(100% + 8px); min-width: 168px; list-style: none; margin: 0; padding: 6px;
    border-radius: 14px; border: 1px solid var(--line-2); background: rgba(16, 19, 25, 0.96);
    backdrop-filter: blur(16px); box-shadow: 0 20px 50px -15px #000;
    animation: pop 0.18s var(--ease);
  }
  @keyframes pop { from { opacity: 0; transform: translateY(-4px) scale(0.98); } }
  .menu a { display: flex; justify-content: space-between; padding: 8px 12px; border-radius: 9px; font-size: 14px; color: var(--muted); }
  @media (pointer: coarse) { .menu a { align-items: center; min-height: 44px; } }
  .menu a:hover, .menu a[aria-current] { background: var(--panel-2); color: var(--text); }
  .menu a span { color: var(--moss); }
  .sm { height: 38px; padding: 0 16px; font-size: 14px; }

  .burger { display: none; width: 38px; height: 38px; border-radius: 10px; border: 1px solid var(--line); background: transparent; cursor: pointer; position: relative; }
  .burger span { position: absolute; left: 11px; right: 11px; height: 1.6px; border-radius: 2px; background: var(--text); transition: transform 0.3s var(--ease), top 0.3s var(--ease); }
  .burger span:first-child { top: 14px; }
  .burger span:last-child { top: 22px; }
  .open .burger span:first-child { top: 18px; transform: rotate(45deg); }
  .open .burger span:last-child { top: 18px; transform: rotate(-45deg); }

  .sheet { border-top: 1px solid var(--line); }
  .sheet nav { display: flex; flex-direction: column; padding: 12px 0 20px; }
  .sheet a:not(.btn) { padding: 13px 4px; font-size: 17px; border-bottom: 1px solid var(--line); }
  .sheet .btn { margin-top: 18px; }

  @media (max-width: 1120px) {
    .links { display: none; }
    .burger { display: block; }
  }
  @media (min-width: 1121px) { .sheet { display: none; } }
  @media (max-width: 560px) {
    .cur, .cta { display: none; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]")!;
  const burger = nav.querySelector<HTMLButtonElement>("[data-burger]")!;
  const sheet = nav.querySelector<HTMLElement>("[data-sheet]")!;
  const lang = nav.querySelector<HTMLDetailsElement>("[data-lang]")!;

  const onScroll = () => nav.classList.toggle("scrolled", scrollY > 8);
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const setOpen = (open: boolean) => {
    sheet.hidden = !open;
    nav.classList.toggle("open", open);
    burger.setAttribute("aria-expanded", String(open));
  };
  burger.addEventListener("click", () => setOpen(!nav.classList.contains("open")));
  sheet.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setOpen(false);
  });

  // Close popovers on outside click / Escape.
  document.addEventListener("click", (e) => {
    if (!lang.contains(e.target as Node)) lang.open = false;
  });
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    lang.open = false;
    setOpen(false);
  });
  matchMedia("(min-width: 1121px)").addEventListener("change", (e) => e.matches && setOpen(false));
</script>
