---
import { themes, type ThemeId } from "../data/themes";
interface Props { current?: ThemeId; mainHref?: string }
const { current, mainHref = "/zh/" } = Astro.props;
const selected = themes.find((theme) => theme.id === current);
---
<details class="fells-theme-switcher" data-theme-switcher lang="zh-CN">
  <summary><span>设计预览</span><b>{selected?.name ?? "三个主题"}</b><span aria-hidden="true">⌃</span></summary>
  <nav aria-label="Fells 主题预览">
    <p>同一个 Fells，三种视觉方向</p>
    {themes.map((theme) => <a href={theme.id === "main" ? mainHref : theme.href} aria-current={theme.id === current ? "page" : undefined}><b>{theme.name}</b><span>{theme.label}</span></a>)}
    <a class="all" href="/themes/" aria-current={!current ? "page" : undefined}>查看主题总览 <span aria-hidden="true">↗</span></a>
    <small>设计样稿；功能和价格以主站说明为准。</small>
  </nav>
</details>
<style>
  .fells-theme-switcher { position: fixed; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom)); z-index: 80; font: 14px/1.5 system-ui, sans-serif; color: #f5f5f7; }
  summary { display: flex; align-items: center; gap: 14px; min-height: 48px; padding: 0 18px; border: 1px solid #444448; border-radius: 999px; background: #1d1d1f; cursor: pointer; list-style: none; box-shadow: 0 8px 28px #0003; }
  summary::-webkit-details-marker { display: none; }
  summary > span:first-child { color: #c4c4ca; font-size: 12px; }
  summary b { font-weight: 600; }
  nav { position: absolute; bottom: calc(100% + 10px); right: 0; width: min(300px, calc(100vw - 32px)); max-height: calc(100dvh - 100px); overflow-y: auto; padding: 10px; border: 1px solid #444448; border-radius: 18px; background: #1d1d1f; box-shadow: 0 16px 48px #0004; }
  p { margin: 4px 8px 10px; color: #c4c4ca; font-size: 12px; }
  a { display: flex; flex-direction: column; justify-content: center; gap: 2px; min-height: 56px; padding: 9px 12px; border-radius: 10px; color: #f5f5f7; text-decoration: none; }
  a span { color: #c4c4ca; font-size: 12px; }
  a:hover, a[aria-current="page"] { background: #343438; text-decoration: none; }
  .all { flex-direction: row; justify-content: space-between; align-items: center; min-height: 44px; margin-top: 6px; border-top: 1px solid #444448; border-radius: 0; }
  small { display: block; margin: 8px; color: #c4c4ca; font-size: 12px; }
  summary:focus-visible, a:focus-visible { outline: 3px solid #f3a37f; outline-offset: 3px; }
  :global(body:has(.fells-theme-switcher)) { padding-bottom: calc(84px + env(safe-area-inset-bottom)); }
</style>
<script>
  document.querySelectorAll<HTMLDetailsElement>("[data-theme-switcher]").forEach((switcher) => {
    document.addEventListener("click", (event) => {
      if (!switcher.contains(event.target as Node)) switcher.open = false;
    });
    switcher.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && switcher.open) {
        switcher.open = false;
        switcher.querySelector("summary")?.focus();
      }
    });
  });
</script>
