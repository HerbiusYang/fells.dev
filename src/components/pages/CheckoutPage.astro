          const item = document.createElement("p"); item.className = "note"; item.textContent = `#${t.id} · ${money(t.amount_micro)} · ${t.status === "unpaid" ? copy.draft : copy.pending}`;
          if (t.status === "unpaid") {
            const button = document.createElement("button"); button.type = "button"; button.className = "linkish"; button.dataset.resumeTopup = String(t.id); button.textContent = copy.paid;
            button.addEventListener("click", () => { if (busy || uncertain) return; draft = t; input("topup_amount").value = String(t.amount_micro / 1_000_000); input("invoice_title").value = String((t as any).invoice_title || ""); input("invoice_tax_no").value = String((t as any).invoice_tax_no || ""); input("invoice_email").value = String((t as any).invoice_email || ""); input("need_invoice").checked = Boolean((t as any).invoice_title); selectedCouponId = Number(t.coupon_id || 0); const method = t.pay_method === "corp" ? "corp" : "alipay"; const choice = form.querySelector<HTMLInputElement>(`input[name="channel"][value="${method}"]`)!; choice.checked = true; legacy = false; say(copy.draft); render(); }); item.append(document.createElement("br"), button);
          }
          $("[data-open-topups]").append(item);
        }
        if (uncertain && intent) {
          const body = JSON.parse(intent.body);
          legacy = false; unavailableOffer = false;
          if (intent.path === "/api/app/allowance/buy") { mode = "token"; const option = form.querySelector<HTMLInputElement>(`input[name="cash"][value="${body.cash_micro}"]`); if (option) option.checked = true; }
          else if (intent.path === "/api/app/subscriptions/buy") { mode = "group"; const option = form.querySelector<HTMLInputElement>(`input[name="seat"][value="${body.pool_id}:${body.tier}"]`); if (option) option.checked = true; input("months").value = String(body.months); }
          else {
            form.querySelector<HTMLInputElement>('input[name="channel"][value="alipay"]')!.checked = true;
            if (body.amount_micro) input("topup_amount").value = String(body.amount_micro / 1_000_000);
            const match = intent.path.match(/^\/api\/app\/topups\/(\d+)\/paid$/);
            if (match) { draft = topups.requests.find(t => t.id === Number(match[1])) ?? null; input("payment_note").value = body.note ?? ""; }
          }
          say(copy.uncertain, true);
        }
        ready = true;
        void refreshCouponOffers();
      } catch (error) {
        if (changed) return;
        if (error instanceof APIError && error.status === 401) { bootstrap = null; $("[data-login-notice]").hidden = false; $<HTMLAnchorElement>("[data-signin]").href = `${form.dataset.login}?next=${encodeURIComponent(location.pathname + location.search)}`; say(copy.login, true); }
        else say(error instanceof Error ? error.message : copy.error, true);
      } finally { loading = false; render(); }
    })();
    if (typeof IntersectionObserver !== "undefined") new IntersectionObserver(([entry]) => { $("[data-paybar]").hidden = entry.isIntersecting; }).observe($("[data-submit]"));
  });
</script>
