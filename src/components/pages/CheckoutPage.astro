---
import type { Dict } from "../../i18n/en";
import Layout from "../../layouts/Layout.astro";
import PromoBar from "../PromoBar.astro";
import Nav from "../Nav.astro";
import Footer from "../Footer.astro";
import SupportWidget from "../SupportWidget.astro";

interface Props { t: Dict }
const { t } = Astro.props;
const lang = t.meta.lang.toLowerCase();
const copy = lang.startsWith("zh-hant")
  ? { title: "透過線上客服購買", body: "請聯絡線上客服確認可購買的服務、價格與付款安排。", action: "聯絡客服購買", note: "客服會在對話中協助你完成購買。" }
  : lang.startsWith("zh")
    ? { title: "通过在线客服购买", body: "请联系在线客服确认可购买的服务、价格和付款安排。", action: "联系客服购买", note: "客服会在对话中协助你完成购买。" }
    : lang.startsWith("ja")
      ? { title: "オンラインサポートから購入", body: "購入できるサービス、価格、お支払い方法については、オンラインサポートにお問い合わせください。", action: "サポートに購入を相談", note: "担当者がチャットで購入をお手伝いします。" }
      : lang.startsWith("ko")
        ? { title: "온라인 고객 지원을 통해 구매", body: "구매 가능한 서비스, 가격 및 결제 방법은 온라인 고객 지원에 문의해 주세요.", action: "고객 지원에 구매 문의", note: "채팅으로 구매를 도와드립니다." }
        : lang.startsWith("es")
          ? { title: "Compra a través de atención al cliente", body: "Contacta con atención al cliente para consultar los servicios disponibles, los precios y las opciones de pago.", action: "Contactar para comprar", note: "Te ayudaremos con la compra por chat." }
          : { title: "Purchase through online support", body: "Contact online support to confirm available services, prices and payment arrangements.", action: "Contact support to purchase", note: "Our team will help you complete your purchase in chat." };
---
<Layout t={t} slug="checkout" title={copy.title} description={copy.body}>
  <PromoBar t={t} />
  <Nav t={t} />
  <main id="main" class="purchase-support">
    <section class="purchase-card" aria-labelledby="purchase-title">
      <span class="kicker">Fells · {lang.startsWith("zh") ? "在线客服" : lang.startsWith("ja") ? "オンラインサポート" : lang.startsWith("ko") ? "온라인 고객 지원" : lang.startsWith("es") ? "Atención al cliente" : "Online support"}</span>
      <h1 id="purchase-title">{copy.title}</h1>
      <p class="lead">{copy.body}</p>
      <button class="btn btn-primary" type="button" data-open-customer-support>{copy.action}</button>
      <p class="purchase-note">{copy.note}</p>
    </section>
  </main>
  <SupportWidget t={t} />
  <Footer t={t} />
</Layout>

<style>
  .purchase-support { min-height: min(68vh, 760px); display: grid; place-items: center; padding: 64px 20px; }
  .purchase-card { width: min(680px, 100%); padding: clamp(28px, 6vw, 56px); text-align: center; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--panel); }
  .purchase-card h1 { margin: 14px 0 0; font-size: clamp(30px, 5vw, 46px); letter-spacing: -.035em; }
  .purchase-card .lead { margin: 16px auto 24px; max-width: 52ch; }
  .purchase-card .btn { min-height: 48px; padding-inline: 22px; }
  .purchase-note { margin: 16px 0 0; color: var(--muted); font-size: 13px; }
</style>
