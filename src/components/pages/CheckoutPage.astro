---
import { publicPurchaseCopy } from "../../i18n/purchase-entry";
import { link } from "../../i18n/index";
import type { Dict } from "../../i18n/en";
import { businessRulesOf } from "../../i18n/business-rules";
import Layout from "../../layouts/Layout.astro";
import PromoBar from "../PromoBar.astro";
import Nav from "../Nav.astro";
import Footer from "../Footer.astro";
import SupportWidget from "../SupportWidget.astro";

interface Props { t: Dict }
const { t } = Astro.props;
const lang = t.meta.lang.toLowerCase();
const terms = businessRulesOf(lang);
const copy = publicPurchaseCopy(lang);
const entryHref = `${link(t,"app/start")}?next=${encodeURIComponent(link(t,"app/")+"#/billing/market")}`;
---
<Layout t={t} slug="checkout" title={copy.title} description={copy.body}>
  <PromoBar t={t} />
  <Nav t={t} />
  <main id="main" class="purchase-support">
    <section class="purchase-card" aria-labelledby="purchase-title">
      <span class="kicker">Fells · CNY / USD</span>
      <h1 id="purchase-title">{copy.title}</h1>
      <p class="lead">{copy.body}</p>
      <div class="purchase-terms">
        <p>{terms.expiry}</p>
        <p>{terms.modes}</p>
        <p>{terms.tokenPlan}</p>
        <p>{terms.webAccount}</p>
      </div>
      <a class="btn btn-primary" href={entryHref} data-purchase-market>{copy.action}</a>
      <p class="purchase-note">{copy.note}</p>
    </section>
  </main>
  <SupportWidget t={t} />
  <Footer t={t} />
</Layout>

<style>
  .purchase-support { min-height: min(68vh, 760px); display: grid; place-items: center; padding: 64px 20px; }
  .purchase-card { width: min(680px, 100%); padding: clamp(28px, 6vw, 56px); text-align: center; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--panel); }
  .purchase-card h1 { margin: 14px 0 0; font-size: clamp(30px, 5vw, 46px); letter-spacing: -.035em; }
  .purchase-card .lead { margin: 16px auto 24px; max-width: 52ch; }
  .purchase-card .btn { min-height: 48px; padding-inline: 22px; }
  .purchase-terms { margin: 0 0 24px; text-align: left; font-size: 14px; color: var(--muted); line-height: 1.6; }
  .purchase-terms p + p { margin-top: 12px; }
  .purchase-note { margin: 16px 0 0; color: var(--muted); font-size: 13px; }
</style>
