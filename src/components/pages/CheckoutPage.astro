---
// Real checkout uses the backend CNY wallet, independent USD allowance and subscription shelf.
import type { Dict } from "../../i18n/en";
import { pagesOf, link } from "../../i18n/index";
import Layout from "../../layouts/Layout.astro";
import PromoBar from "../PromoBar.astro";
import Nav from "../Nav.astro";
import Footer from "../Footer.astro";
interface Props { t: Dict }
const { t } = Astro.props;
const c = pagesOf(t).checkout;
const slug = "checkout";
const zh = t.meta.lang.startsWith("zh");
const copy = {
  title: zh ? "选择服务或充值钱包" : "Choose a service or top up your wallet",
  sub: zh ? "使用人民币现金购买订阅或兑换独立美元 API 额度。充值确认与购买服务分开进行。" : "Use CNY cash to buy subscriptions or exchange it for separate USD API allowance. Top-up confirmation and service purchases are separate steps.",
  token: zh ? "API 额度" : "API allowance", group: zh ? "订阅" : "Subscriptions",
  loading: zh ? "正在加载服务器商品…" : "Loading available services…",
  unsupported: zh ? "此链接中的 Token Plan／拼团 SKU 尚未开通。它不会转换为其他收费产品；请明确选择下方现有服务。" : "The Token Plan or group SKU in this link is not available. Choose an available service explicitly to place a different order.",
  cdk: zh ? "CDK 商品激活尚未开通。不能用活动码代替商品兑换，当前不会提交或扣款。" : "Product CDK activation is unavailable. Campaign codes cannot activate products; no redemption or charge will be submitted.",
  noPlans: zh ? "当前没有可自助购买的订阅。" : "No subscriptions are currently available for self-service purchase.",
  missingPlan: zh ? "此订阅当前未在售。请明确选择服务器提供的其他档位。" : "This subscription is currently unavailable. Explicitly choose another available tier.",
  noAllowance: zh ? "美元 API 额度兑换当前未开放。" : "USD API allowance exchange is currently closed.",
  wallet: zh ? "人民币钱包" : "CNY wallet", cash: zh ? "人民币现金" : "CNY cash", grant: zh ? "人民币赠金" : "CNY grant",
  usd: zh ? "独立美元 API 额度" : "Separate USD API allowance", balance: zh ? "当前账户余额" : "Current account balances",
  exchange: zh ? "确认兑换 API 额度" : "Confirm allowance exchange", buy: zh ? "确认购买订阅" : "Confirm subscription purchase",
  alipay: zh ? "支付宝充值" : "Alipay top-up", alipayNote: zh ? "先充值，审核入账后再购买服务" : "Top up first; buy services after the credit is confirmed",
  corp: zh ? "对公转账" : "Bank transfer", corpNote: zh ? "企业付款，需开具发票" : "Business payment with a required invoice",
  corpAccount: zh ? "收款户名" : "Account name", corpBank: zh ? "开户银行" : "Bank", corpNumber: zh ? "银行账号" : "Account number",
  tax: zh ? "开票税额" : "Invoice tax", taxDue: zh ? "实际付款总额" : "Total due",
  shop: zh ? "平台订单" : "Marketplace order", closed: zh ? "尚未开通" : "Unavailable",
  walletNote: zh ? "从已入账的人民币现金扣款" : "Debited from confirmed CNY cash",
  total: zh ? "人民币金额" : "CNY amount", term: zh ? "购买期数（每期 30 天）" : "Terms (30 days each)",
  allowanceNote: zh ? "一次性兑换，按服务器价格计量；无月度保底、burst 或自动续费。" : "A one-time exchange at the server rate; no monthly guarantee, burst or automatic renewal.",
  groupNote: zh ? "使用服务器在售档位与份额控制规则，按月价乘购买期数；没有年付折扣。" : "Uses the available server tiers and share limits. Price is multiplied by the number of terms; no annual discount.",
  expiry: zh ? "有效期" : "Valid for", months: zh ? "个月" : "months", estimate: zh ? "预计兑换" : "Estimated allowance",
  due: zh ? "确认后从人民币现金扣除" : "Debited from CNY cash after confirmation",
  rechargeAmount: zh ? "充值人民币金额" : "CNY top-up amount", transfer: zh ? "付款备注／转账凭证" : "Payment reference",
  couponCode: zh ? "活动优惠码" : "Promotion code", claimCoupon: zh ? "领取优惠券" : "Claim coupon",
  couponClaimed: zh ? "优惠券已加入账户；如适用于当前订单，可在下方选择。" : "Coupon added to your account. Select it below if it applies to this order.",
  couponNone: zh ? "当前订单没有可用优惠券" : "No coupons apply to this order",
  couponSelect: zh ? "使用优惠券" : "Apply a coupon", discount: zh ? "优惠" : "Discount",
  invoice: zh ? "需要开具发票" : "I need an invoice", invoiceTitle: zh ? "发票抬头" : "Invoice title",
  invoiceTax: zh ? "统一社会信用代码／税号" : "Tax ID", invoiceEmail: zh ? "接收发票的邮箱" : "Invoice email",
  invoiceTaxNote: zh ? "开票税额按服务端税率另计；最终金额以充值申请显示为准。" : "Invoice tax is added at the server-configured rate. The top-up request shows the final amount.",
  createTopup: zh ? "创建充值申请" : "Create top-up request", paid: zh ? "我已实际付款，提交核对" : "I have paid; submit for verification",
  cancelDraft: zh ? "取消充值草稿" : "Cancel top-up draft", credited: zh ? "充值已确认入账。它不会自动购买服务，请另外确认购买。" : "The top-up has been credited. Confirm a service purchase separately.",
  balanceRefreshFailed: zh ? "余额刷新失败，请刷新页面查看；不要重复提交这笔充值。" : "Balances could not be refreshed. Reload this page to view them; do not submit this top-up again.",
  draft: zh ? "充值申请已创建。请按收款信息实际付款，再提交核对；这一步不会开通套餐。" : "Your top-up draft is created. Pay using the payment instructions, then submit for verification. This step does not activate a subscription.",
  pending: zh ? "已提交付款核对。当前不代表入账或套餐已开通，请等待确认。" : "Payment verification submitted. This does not mean funds are credited or a service is active. Wait for confirmation.",
  topupClosed: zh ? "当前未配置此充值方式，请联系客服。" : "This top-up method is not configured. Contact support.",
  terms: zh ? "阅读并同意当前服务条款" : "Read and agree to the current terms",
  login: zh ? "请先登录真实账户，再进行交易。" : "Sign in to your account before making a transaction.",
  loginLink: zh ? "登录／注册" : "Sign in / sign up", account: zh ? "交易账户" : "Account",
  success: zh ? "交易已由服务器确认，余额已更新。" : "The server confirmed this transaction. Balances have been refreshed.",
  uncertain: zh ? "结果尚待确认，请使用同一操作重试。不要更改金额或另开一笔交易。" : "The result needs confirmation. Retry the same operation; do not change the amount or start another transaction.",
  changed: zh ? "账户会话已变化，请刷新此页后继续。" : "The account session changed. Refresh this page before continuing.",
  priceChanged: zh ? "订阅价格已变化，本次未扣款。已刷新价格，请重新核对并勾选确认。" : "The subscription price changed; this purchase was not charged. Review the refreshed price and confirm again.",
  error: zh ? "连接失败，请重试。" : "Unable to connect. Please retry.",
  retry: zh ? "重试同一操作" : "Retry the same operation", purchased: zh ? "交易已完成，重新确认可开始下一笔" : "Transaction complete. Confirm again to start another purchase",
};
---
<Layout t={t} slug={slug} title={c.metaTitle} description={copy.sub}>
  <PromoBar t={t} offer={{ title: copy.wallet, body: copy.sub, href: link(t, "app") + "#/billing/credits" }} /><Nav t={t} slug={slug} />
  <main class="section co"><div class="wrap">
    <a class="back" href={link(t) + "#plans"}>← {c.back}</a>
    <span class="kicker">{c.kicker}</span><h1 class="h2">{copy.title}</h1><p class="lead">{copy.sub}</p>
    <form method="post" class="grid" data-checkout data-copy={JSON.stringify(copy)} data-login={link(t, "app/start")}>
      <div class="pick">
        <div class="seg" role="tablist" aria-label={c.title}>
          <button type="button" role="tab" aria-selected="true" data-mode="token">{copy.token}</button>
          <button type="button" role="tab" aria-selected="false" data-mode="group">{copy.group}</button>
          <button type="button" role="tab" aria-selected="false" data-mode="redeem">{c.tabRedeem}</button>
        </div>
        <p class="note err" data-unsupported hidden>{copy.unsupported}</p>
        <fieldset data-pane="token"><legend>{copy.token}</legend><div class="opts" data-allowance-options><p class="note">{copy.loading}</p></div><p class="note">{copy.allowanceNote}</p></fieldset>
        <fieldset data-pane="group" hidden><legend>{copy.group}</legend><div class="opts" data-subscription-options><p class="note">{copy.loading}</p></div><label class="field">{copy.term}<input disabled type="number" name="months" min="1" max="12" step="1" value="1" /></label><p class="note">{copy.groupNote}</p></fieldset>
        <fieldset data-pane="redeem" hidden><legend>{c.redeemTitle}</legend><p class="note first">{copy.cdk}</p><label class="field">{c.cdk}<input disabled type="text" name="cdk" autocomplete="off" maxlength="40" placeholder="XXXX-XXXX-XXXX-XXXX" /></label><p class="note">{c.noCdk} <button type="button" class="linkish" data-goto="token">{copy.token} →</button></p></fieldset>
        <fieldset data-channel><legend>{c.channel}</legend><div class="opts four">
          <label class="opt"><input disabled type="radio" name="channel" value="wallet" checked /><span><b><i class="mk ali" aria-hidden="true">¥</i>{copy.wallet}</b><small>{copy.walletNote}</small></span></label>
          <label class="opt"><input disabled type="radio" name="channel" value="alipay" /><span><b><i class="mk ali" aria-hidden="true">支</i>{copy.alipay}</b><small>{copy.alipayNote}</small></span></label>
          <label class="opt" data-corp-option hidden><input disabled type="radio" name="channel" value="corp" /><span><b><i class="mk ali" aria-hidden="true">企</i>{copy.corp}</b><small>{copy.corpNote}</small></span></label>
          <label class="opt"><input disabled type="radio" name="channel" value="shop" /><span><b><i class="mk tb" aria-hidden="true">淘</i>{copy.shop}</b><small>{copy.closed}</small></span></label>
        </div></fieldset>
        <fieldset data-topup hidden><legend data-topup-legend>{copy.alipay}</legend>
          <label class="field">{copy.rechargeAmount}<input disabled type="number" name="topup_amount" min="0.01" max="1000000" step="0.01" value="100" /></label>
          <div class="invoice-fields" data-invoice hidden>
            <label class="agree" data-invoice-choice><input disabled type="checkbox" name="need_invoice" /> <span>{copy.invoice}</span></label>
            <label class="field">{copy.invoiceTitle}<input disabled type="text" name="invoice_title" maxlength="100" autocomplete="organization" /></label>
            <label class="field">{copy.invoiceTax}<input disabled type="text" name="invoice_tax_no" maxlength="30" autocomplete="off" /></label>
            <label class="field">{copy.invoiceEmail}<input disabled type="email" name="invoice_email" maxlength="254" autocomplete="email" /></label>
            <p class="note">{copy.invoiceTaxNote}</p>
          </div>
          <p class="note" data-payment-info></p><img data-payment-qr hidden alt={copy.alipay} width="220" height="220" />
          <div class="note" data-corp-info hidden><b>{copy.corp}</b><p><span>{copy.corpAccount}: </span><span data-corp-account></span></p><p><span>{copy.corpBank}: </span><span data-corp-bank></span></p><p><span>{copy.corpNumber}: </span><span data-corp-number></span></p></div>
          <label class="field">{copy.transfer}<input disabled type="text" name="payment_note" maxlength="500" autocomplete="off" /></label>
          <button class="linkish" type="button" data-cancel-draft hidden>{copy.cancelDraft}</button>
          <div data-open-topups></div>
        </fieldset>
        <section class="coupon" data-coupon hidden aria-label={copy.couponSelect}>
          <label class="field">{copy.couponCode}<span class="claim-row"><input disabled type="text" name="coupon_code" maxlength="64" autocomplete="off" /><button class="btn sm" type="button" data-claim-coupon disabled>{copy.claimCoupon}</button></span></label>
          <p class="note" data-coupon-msg role="status" aria-live="polite"></p>
          <label class="field" data-coupon-select hidden>{copy.couponSelect}<select disabled name="coupon_id"><option value="0">—</option></select></label>
        </section>
      </div>
      <aside class="sum">
        <div data-summary><h2>{c.summary}</h2><p class="item" data-item>—</p><dl>
          <div><dt>{copy.cash}</dt><dd data-cash>—</dd></div><div><dt>{copy.grant}</dt><dd data-grant>—</dd></div><div><dt>{copy.usd}</dt><dd data-usd>—</dd></div>
          <div data-tax-row hidden><dt>{copy.tax}</dt><dd data-tax>—</dd></div>
          <div class="tot"><dt>{copy.total}</dt><dd data-total>—</dd></div>
        </dl></div>
        <div data-account><label class="field">{copy.account}<input disabled type="text" name="account" readonly /></label>
          <p class="fine" data-login-notice hidden>{copy.login} <a data-signin href={link(t, "app/start")}>{copy.loginLink}</a></p>
          <details class="reward"><summary>{copy.terms}</summary><div class="fine terms" data-terms></div></details>
          <label class="agree"><input disabled type="checkbox" name="agree" required /> <span>{copy.terms}</span></label>
        </div>
        <button class="btn btn-primary pay" type="submit" disabled data-submit>{copy.exchange}</button>
        <p class="msg" data-msg role="status" aria-live="polite"></p>
        <p class="fine" data-pay-note>{copy.due}</p><p class="fine" data-summary-note>{copy.alipayNote}</p>
      </aside>
      <div class="paybar" data-paybar hidden><span data-bar-total>—</span><button class="btn btn-primary" type="submit" disabled data-bar-submit>{copy.exchange}</button></div>
    </form>
  </div></main><Footer t={t} slug={slug} />
</Layout>
<style>
  [hidden] { display: none !important; }
  .terms { max-height: 240px; overflow: auto; white-space: pre-wrap; }
  [data-payment-info] { white-space: pre-wrap; }
  .invoice-fields, .coupon { margin-top: 16px; padding: 14px; border: 1px solid var(--line); border-radius: 14px; }
  .invoice-fields { display: grid; gap: 10px; }
  .claim-row { display: flex; gap: 8px; }
  .claim-row input { flex: 1; min-width: 0; }
  [data-coupon-msg]:empty { display: none; }
  [data-payment-qr] { max-width: 100%; object-fit: contain; margin-top: 14px; }
  input[name="account"], input[name="payment_note"] { text-transform: none; letter-spacing: normal; font-family: inherit; }
  button:disabled { opacity: .55; cursor: wait; }
  .co { padding-top: clamp(40px, 6vw, 72px); }
  .back { display: block; width: fit-content; margin-bottom: 12px; padding: 12px 0; color: var(--muted); font-size: 14px; }
  .back:hover { color: var(--text); }
  .grid { margin-top: 36px; display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 20px; align-items: start; }
  .pick, .sum { padding: clamp(18px, 3vw, 28px); border-radius: var(--radius-lg); border: 1px solid var(--line-2); background: linear-gradient(180deg, #11141a, #0b0d11); }
  .seg { display: inline-flex; gap: 4px; padding: 4px; max-width: 100%; border-radius: 999px; border: 1px solid var(--line); background: rgba(0, 0, 0, 0.3); }
  .seg button { border: 0; background: transparent; color: var(--muted); cursor: pointer; border-radius: 999px; min-height: 44px; padding: 8px 18px; font-size: 14px; font-weight: 550; white-space: nowrap; }
  .seg button[aria-selected="true"] { background: var(--text); color: #0b0d10; }
  fieldset { border: 0; padding: 0; margin: 8px 0 0; min-width: 0; }
  fieldset[hidden], [data-summary][hidden], [data-account][hidden], .steps[hidden], .fine[hidden], .reward[hidden], .note[hidden] { display: none; }
  legend { float: left; width: 100%; margin: 22px 0 10px; font: 500 12px var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .opts { clear: both; display: grid; gap: 10px; }
  .three { grid-template-columns: repeat(3, 1fr); }
  .opt { position: relative; cursor: pointer; }
  .opt input { position: absolute; opacity: 0; pointer-events: none; }
  .opt > span { display: flex; flex-direction: column; gap: 4px; height: 100%; padding: 14px 16px; border-radius: 14px; border: 1px solid var(--line); background: rgba(255, 255, 255, 0.025); transition: border-color 0.2s, background 0.2s; }
  .opt > .row { flex-direction: row; align-items: center; justify-content: space-between; gap: 14px; }
  .what, .cost { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .cost { flex: none; align-items: flex-end; }
  .opt b { font-size: 15px; font-weight: 600; display: flex; align-items: center; flex-wrap: wrap; gap: 6px 8px; }
  .opt em { font-style: normal; font-size: 12px; font-weight: 550; padding: 2px 8px; border-radius: 999px; background: rgba(134, 214, 173, 0.12); color: var(--moss); }
  .opt small { color: var(--muted); font-size: 13px; line-height: 1.45; }
  .cost b { font-size: 19px; font-weight: 700; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; gap: 3px; }
  .cost i { font-style: normal; font-size: 13px; font-weight: 400; color: var(--muted); }
  .off { font: 600 12px var(--mono); padding: 2px 8px; border-radius: 6px; background: rgba(224, 122, 85, 0.18); color: var(--ember-2); }
  .pending { font-size: 12px; padding: 2px 8px; border-radius: 999px; border: 1px dashed var(--line-2); color: var(--muted); }
  .opt:hover > span { border-color: var(--line-2); }
  .opt input:checked + span { border-color: var(--ember); background: rgba(224, 122, 85, 0.08); }
  .opt input:focus-visible + span { outline: 2px solid var(--ember-2); outline-offset: 2px; }
  .mk { flex: none; width: 22px; height: 22px; border-radius: 6px; display: grid; place-items: center; font: normal 600 13px var(--font); color: #fff; }
  .mk.ali { background: #1677ff; }
  .mk.tb { background: #ff5000; }
  .mk.xy { background: #ffe60f; color: #111; }
  .steps { clear: both; margin: 14px 0 0; padding: 14px 16px 14px 36px; border-radius: 14px; border: 1px dashed var(--line-2); color: var(--muted); font-size: 14px; display: grid; gap: 6px; }
  input[type="text"], input[type="email"], input[type="number"] { width: 100%; height: 46px; padding: 0 14px; border-radius: 12px; border: 1px solid var(--line-2); background: rgba(0, 0, 0, 0.35); color: var(--text); font: inherit; font-size: 16px; }
  input[type="text"] { font-family: var(--mono); letter-spacing: 0.06em; text-transform: uppercase; }
  input::placeholder { color: var(--dim); text-transform: none; }
  .note { clear: both; margin: 14px 0 0; color: var(--muted); font-size: 13.5px; }
  .note.first { margin-top: 0; }
  .linkish { border: 0; background: none; padding: 6px 0; color: var(--ember-2); cursor: pointer; font-size: inherit; }
  .linkish:hover { text-decoration: underline; }
  .sum { position: sticky; top: 96px; }
  .sum h2 { margin: 0; font-size: 17px; font-weight: 600; }
  .item { margin: 10px 0 0; color: var(--muted); font-size: 14.5px; }
  dl { margin: 18px 0 0; padding: 16px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 10px; font-size: 14px; }
  dl div { display: flex; justify-content: space-between; gap: 12px; }
  dt { color: var(--muted); }
  dd { margin: 0; font-variant-numeric: tabular-nums; }
  dd s { color: var(--muted); }
  .disc { color: var(--moss); }
  .tot { font-size: 18px; font-weight: 650; padding-top: 6px; }
  .tot dt { color: var(--text); }
  .field { clear: both; display: flex; flex-direction: column; gap: 8px; margin-top: 20px; font-size: 13.5px; color: var(--muted); }
  [data-summary][hidden] + [data-account] .field:first-child { margin-top: 0; }
  .reward { margin-top: 14px; font-size: 13.5px; color: var(--muted); }
  .reward summary { cursor: pointer; padding: 6px 0; width: fit-content; }
  .reward summary:hover { color: var(--text); }
  .reward input { margin-top: 8px; }
  .agree { display: flex; gap: 10px; align-items: flex-start; margin-top: 14px; padding: 4px 0; font-size: 13.5px; color: var(--muted); cursor: pointer; }
  .agree input { flex: none; width: 18px; height: 18px; margin: 1px 0 0; accent-color: var(--ember); }
  .pay { width: 100%; height: 50px; margin-top: 18px; font-size: 16px; }
  .msg { margin: 12px 0 0; font-size: 14px; color: var(--moss); }
  .msg.err { color: var(--ember-2); }
  .msg:empty { display: none; }
  .fine { margin: 12px 0 0; font-size: 13px; color: var(--muted); }
  .sec { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-direction: column; gap: 8px; font-size: 13.5px; color: var(--muted); }
  .sec li::before { content: "✓ "; color: var(--moss); }
  .paybar { display: none; }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .sum { position: static; }
    .co { padding-bottom: 96px; }
    .paybar:not([hidden]) {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); border-top: 1px solid var(--line-2); background: rgba(11, 13, 17, 0.94); backdrop-filter: blur(14px);
    }
    .paybar span { font-size: 18px; font-weight: 650; font-variant-numeric: tabular-nums; }
    .paybar .btn { flex: 1; max-width: 240px; margin-left: auto; }
  }
  @media (max-width: 640px) { .three { grid-template-columns: 1fr; } .seg { display: flex; border-radius: 18px; } .seg button { flex: 1; padding: 8px 6px; border-radius: 14px; white-space: normal; line-height: 1.2; } }
</style>
<script>
  import { accountApi, setExpectedUser, transactionIntent, cnyToMicro, type BootstrapDto, type WalletDto, type AllowanceResponse, type SubscriptionsDto, type AgreementDto, type TopupDto, type MoneyIntent } from "../../lib/account-api";
  import { operationKey } from "../../lib/app-http";
  import { APIError } from "../../lib/app-http";
  type Mode = "token" | "group" | "redeem";
  document.querySelectorAll<HTMLFormElement>("[data-checkout]").forEach(form => {
    form.addEventListener("submit", e => e.preventDefault());
    const $ = <T extends HTMLElement>(s: string) => form.querySelector<T>(s)!;
    const input = (name: string) => $<HTMLInputElement>(`input[name="${name}"]`);
