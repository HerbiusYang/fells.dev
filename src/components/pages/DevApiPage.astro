---
import type { Dict } from "../../i18n/en";
import { pagesOf, link } from "../../i18n/index";
import { publicFacts } from "../../i18n/public-facts";
import { publicPurchaseCopy } from "../../i18n/purchase-entry";
import PageShell from "../PageShell.astro";
import PageHero from "../PageHero.astro";
import PublicCatalog from "../PublicCatalog.astro";
interface Props { t: Dict }
const { t } = Astro.props;
const a = pagesOf(t).api, facts = publicFacts(t.meta.lang), purchase = publicPurchaseCopy(t.meta.lang);
---
<PageShell t={t} slug="developer-api" title={a.metaTitle} description={facts.apiBody}>
  <PageHero n="02" kicker={a.kicker} title={facts.apiTitle} sub={facts.apiBody}>
    <div class="acts"><a class="btn btn-primary" data-public-account-guide href={`${link(t, "app")}#/api`}>{facts.accountGuide}</a><a class="btn btn-ghost" href={link(t, "market")}>{a.viewPlans}</a></div>
  </PageHero>
  <section class="section tight" id="setup"><div class="wrap steps">
    <article data-public-client-guide><span class="kicker">01</span><h2>{purchase.title}</h2><p>{purchase.body}</p><p class="hint">{purchase.note}</p><button type="button" class="btn btn-ghost" data-open-customer-support>{purchase.action}</button></article>
    <article><span class="kicker">02</span><h2>{facts.setupTitle}</h2><p>{facts.setupBody}</p><p class="hint">Token Plan · {purchase.realIntro}</p><a class="btn btn-primary" href={`${link(t, "app")}#/api`}>{facts.accountGuide}</a></article>
  </div></section>
  <section class="section tight"><div class="wrap"><h2>{facts.modelTitle}</h2><p class="lead">{facts.modelBody}</p><PublicCatalog t={t} kind="models" /></div></section>
</PageShell>
<style>
  .acts { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .tight { padding-top: 0; }
  .steps { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  article { min-width: 0; padding: clamp(22px, 4vw, 36px); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--panel); }
  h2 { font-size: clamp(22px, 3vw, 30px); line-height: 1.4; margin: 16px 0; }
  article p { line-height: 1.8; color: var(--muted); }
  .hint { font-size: 13px; }
  .btn { margin-top: 14px; white-space: normal; text-align: center; }
  .public-catalog { margin-top: 28px; }
  @media(max-width: 760px) { .steps { grid-template-columns: 1fr; } }
</style>
