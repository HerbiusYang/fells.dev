  .fx .model-chat-welcome p { max-width: 440px; margin: 0; color: var(--muted); text-align: center; font-size: 14px; }
  .fx .agent-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; }
  .fx .agent-tabs button { display: inline-flex; align-items: center; gap: 7px; height: 36px; padding: 0 12px; border: 1px solid transparent; border-radius: 999px; background: none; cursor: pointer; color: var(--muted); }
  .fx .agent-tabs button:hover { background: var(--hover); }
  .fx .agent-tabs button[aria-selected="true"] { border-color: var(--line-2); background: var(--panel); color: var(--text); font-weight: 600; box-shadow: 0 1px 3px rgba(0,0,0,.06); }
  .fx .agent-card { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 18px; width: min(700px, 100%); padding: 12px; border-radius: 18px; border: 1px solid var(--line); background: var(--sub); }
  .fx .agent-art { position: relative; display: grid; place-items: center; min-height: 240px; border-radius: 12px; border: 1px solid var(--line); background: var(--panel); background-image: radial-gradient(var(--line-2) 1px, transparent 1px); background-size: 14px 14px; overflow: hidden; }
  .fx .agent-art .blob { width: 112px; height: 112px; display: grid; place-items: center; border-radius: 38% 62% 55% 45% / 45% 40% 60% 55%; background: radial-gradient(circle at 30% 30%, color-mix(in srgb, var(--hue) 50%, #fff), var(--hue)); color: var(--panel); font-size: 44px; font-weight: 700; box-shadow: 0 30px 40px -24px var(--hue); animation: fx-float 6s ease-in-out infinite; }
  .fx .agent-art .blob svg { width: 50px; height: 50px; }
