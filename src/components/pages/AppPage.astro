  .fx .chat-markdown pre { max-width: 100%; margin-bottom: 0; padding: 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--sub); overflow: auto; white-space: pre; }
  .fx .chat-markdown pre code { padding: 0; background: none; }
  .fx .chat-markdown a { text-decoration: underline; text-underline-offset: 3px; }
  .fx .chat-markdown blockquote { margin-left: 0; padding-left: 14px; border-left: 3px solid var(--line-2); color: var(--muted); }
  .fx .chat-table-scroll { max-width: 100%; overflow-x: auto; overscroll-behavior-x: contain; border: 1px solid var(--line); border-radius: 10px; }
  .fx .chat-table-scroll:focus-visible { outline: 2px solid var(--muted); outline-offset: 2px; }
  .fx .chat-table-scroll table { width: 100%; border-collapse: collapse; font-size: .94em; }
  .fx .chat-table-scroll th, .fx .chat-table-scroll td { min-width: 100px; padding: 9px 12px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .fx .chat-table-scroll th { background: var(--sub); font-weight: 650; }
  .fx .chat-table-scroll tr:last-child td { border-bottom: 0; }
  .fx .chat-table-scroll [data-align="center"] { text-align: center; }
  .fx .chat-table-scroll [data-align="right"] { text-align: right; }
  .fx [data-thread] { overflow-y: scroll; overscroll-behavior: contain; scrollbar-gutter: stable; scrollbar-width: thin; scrollbar-color: var(--muted) var(--sub); }
  .fx [data-thread]::-webkit-scrollbar, .fx .composer textarea::-webkit-scrollbar { width: 10px; height: 10px; }
  .fx [data-thread]::-webkit-scrollbar-thumb, .fx .composer textarea::-webkit-scrollbar-thumb { min-height: 32px; border: 2px solid var(--panel); border-radius: 6px; background: var(--muted); }
  .fx [data-thread]::-webkit-scrollbar-track, .fx .composer textarea::-webkit-scrollbar-track { background: var(--sub); }
  .fx .msg.user { align-self: flex-end; max-width: 82%; padding: 10px 14px; border-radius: 14px; background: var(--field); }
