  }
  .fx .scrim { position: fixed; inset: 0; z-index: 70; display: grid; place-items: center; padding: 16px; background: rgba(15, 15, 20, .38); animation: fx-fade .15s ease; }
  .fx .dlg { position: relative; width: min(480px, 100%); max-height: calc(100vh - 32px); overflow: auto; padding: 22px 24px; border-radius: 16px; background: var(--panel); box-shadow: var(--shadow); animation: fx-rise .2s cubic-bezier(.2,.8,.2,1); }
  .fx .dlg.wide { width: min(720px, 100%); }
