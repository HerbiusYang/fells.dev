  /* Chat thread */
  .fx .thread { width: min(760px, 100%); margin: 0 auto; padding: 24px 20px 30px; display: flex; flex-direction: column; gap: 22px; }
  .fx .msg-who { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 13.5px; }
  .fx .msg-body { margin-top: 6px; white-space: pre-wrap; line-height: 1.65; overflow-wrap: anywhere; }
  .fx .msg-body.chat-markdown { white-space: normal; min-width: 0; }
