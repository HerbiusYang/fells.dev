  .fx .composer { width: min(740px, 100%); margin: 0 auto; border-radius: 16px; border: 1px solid var(--line-2); background: var(--panel); box-shadow: 0 12px 40px -24px rgba(80, 90, 255, .5); }
  .fx .composer textarea { display: block; min-height: 64px; max-height: 240px; border: 0; background: none; resize: none; padding: 14px 16px 6px; }
  .fx .composer textarea:focus { background: none; border: 0; }
  .fx .composer textarea:focus-visible { outline: none; box-shadow: none; }
  .fx .composer:has(textarea:focus-visible) { border-color: var(--muted); box-shadow: 0 0 0 1px var(--line-2); }
  .fx .composer textarea { overflow-y: auto; max-height: min(180px, 25dvh); scrollbar-width: thin; scrollbar-color: var(--muted) var(--panel); }
  .fx .composer .tools { display: flex; align-items: center; gap: 2px; padding: 6px 8px 8px; }
  .fx .composer .tools .r { margin-left: auto; display: flex; align-items: center; gap: 4px; min-width: 0; }
  .fx .composer.off { opacity: .6; }
  .fx .chat-web-search { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; padding: 4px 8px; border: 1px solid transparent; border-radius: 8px; background: none; color: var(--muted); font-size: 12px; white-space: nowrap; cursor: pointer; }
  .fx .chat-web-search[aria-pressed="true"] { color: var(--text); border-color: var(--line-2); background: var(--field); }
