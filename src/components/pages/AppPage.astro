  .fx .model-btn { display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 8px; border: 0; border-radius: 8px; background: none; cursor: pointer; font-size: 13px; font-weight: 550; min-width: 0; max-width: 100%; }
  .fx .model-btn span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
