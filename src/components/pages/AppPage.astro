  .fx .chat-run-indicator.is-active i { animation: chat-run-pulse 1.4s ease-in-out infinite; }
  .fx .chat-run-indicator.is-active i:nth-child(2) { animation-delay: .15s; }
  .fx .chat-run-indicator.is-active i:nth-child(3) { animation-delay: .3s; }
  @keyframes chat-run-pulse { 50% { opacity: .25; transform: translateY(-3px); } }
  .fx .chat-latest-row { display: flex; justify-content: center; flex: none; }
