  .fx .opts.four { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .fx .opt { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 42px; padding: 8px 14px; border-radius: 10px; border: 1px solid var(--line); background: var(--panel); cursor: pointer; text-align: left; }
  .fx .opt:hover { border-color: var(--line-2); }
