  .fx .send { width: 32px; height: 32px; flex: none; border: 0; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: var(--on-ink); cursor: pointer; }
  .fx .send[disabled] { background: var(--dim); cursor: not-allowed; }
  .fx .chat-execution-note { margin: 8px auto 0; width: min(740px, calc(100% - 40px)); }
  .fx .chat-model-state { width: min(740px, 100%); margin: 0 auto 10px; color: var(--muted); font-size: 12px; }
  .fx .chat-key-toolbar { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 12px; }
