  .fx .agent-info .by { display: flex; align-items: center; gap: 6px; margin-top: 2px; color: var(--muted); font-size: 13px; }
  .fx .agent-info > p { margin: 10px 0 12px; color: var(--muted); }
  .fx .stat { padding: 10px 12px; border-radius: 10px; border: 1px solid var(--line); background: var(--panel); font-size: 13px; }
  .fx .stat .between b { font-weight: 600; }
