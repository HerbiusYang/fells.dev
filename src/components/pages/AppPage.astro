---
// /app — signed-in experience (front-end prototype). Views are rendered client-side by
// src/scripts/app.ts; account and workspace data are loaded from the backend.
import type { Dict } from "../../i18n/en";
import { appOf, pagesOf, link, locales, localeOf } from "../../i18n/index";
import { agents, appModels, planCovers, creditTiers, signupBonus, appChannels, imageModels } from "../../data/app";
import { site } from "../../site";
import { agentMarks, providerMarks, imageModelMarks, channelMarks } from "../../data/icons";
import { previewCopy } from "../../i18n/preview";
import { appStartupWords } from "../../i18n/app-startup";
import Layout from "../../layouts/Layout.astro";
import SupportWidget from "../SupportWidget.astro";
import "../../styles/chat-attachments.css";
interface Props { t: Dict }
const { t } = Astro.props;
const a = appOf(t);
const m = pagesOf(t).market;
const current = localeOf(t);
const startup = appStartupWords(t.meta.lang);
const data = {
  a,
  startup,
  security: previewCopy(t.meta.lang),
  lang: t.meta.lang,
  links: { home: link(t), start: link(t, "app/start"), market: link(t, "market"), api: link(t, "developer-api"), blog: link(t, "blog") },
  locales: locales.map((l) => ({ label: l.label, href: l.path + "app", current: l === current })),
  market: { channels: m.channels, providerDesc: m.providerDesc, directDesc: m.directDesc, sameAsList: m.sameAsList, metrics: m.metrics, levels: m.levels, perMonth: m.perMonth, perM: m.perM, from: m.from, inputFrom: m.inputFrom, more: m.more },
  agents, models: appModels, imageModels, planCovers, creditTiers, signupBonus, channels: appChannels,
  contact: site.contactEmail,
  marks: { agents: agentMarks, providers: providerMarks, images: imageModelMarks, channels: channelMarks },
};
---
<Layout t={t} slug="app" mainId="fx-main" title={a.metaTitle} description={t.meta.description}>
  <div class="fx" id="fx" aria-busy="true">
    <aside class="boot-sidebar" aria-hidden="true">
      <strong>Fells</strong>
      <span></span><span></span><span></span>
    </aside>
    <main class="main boot-main" id="fx-main" data-app-boot>
      <header class="bar"><h1>{a.metaTitle}</h1></header>
      <div class="boot-content">
        <div class="boot-placeholder" aria-hidden="true"></div>
        <p role="status">{startup.loading}</p>
        <p class="muted">{startup.hint}</p>
        <a href={link(t, "app/start")}>{startup.entry}</a>
        <noscript><p>{startup.jsRequired}</p></noscript>
      </div>
    </main>
  </div>
  <SupportWidget t={t} />
  <script type="application/json" id="fx-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />
</Layout>

<style is:global>
  /* App theme: light by default like the signed-in product, with a dark mode. */
  .fx {
    color-scheme: light;
    --bg: #f4f4f3; --panel: #ffffff; --sub: #f7f7f6; --field: #f1f1f0; --hover: #ebebea; --sel: #e4e4e2;
    --text: #18181a; --muted: #6b6b70; --dim: #9a9a9f; --line: #e8e8e6; --line-2: #dcdcd9;
    --accent: #e07a55; --accent-2: #c45f3b; --ok: #1f8a57; --warn: #b7791f; --bad: #c2412d; --ink: #18181a; --on-ink: #fff;
    --shadow: 0 18px 50px -20px rgba(20, 20, 30, 0.28), 0 2px 8px -2px rgba(20, 20, 30, 0.08);
    --r: 12px;
    position: fixed; inset: 0 0 auto; height: var(--app-height, 100dvh); top: var(--app-top, 0px); display: grid; grid-template-rows: minmax(0, 1fr); grid-template-columns: 264px minmax(0, 1fr); background: var(--bg); color: var(--text);
    font: 400 14px/1.5 var(--font, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif); -webkit-font-smoothing: antialiased; overflow: hidden;
  }
  .fx.sb-hidden { grid-template-columns: 0 minmax(0, 1fr); }
  .fx.sb-hidden .sb { visibility: hidden; }
  .fx .boot-sidebar { padding: 22px 20px; }
  .fx .boot-sidebar strong { display: block; margin-bottom: 32px; font-size: 18px; }
  .fx .boot-sidebar span { display: block; height: 12px; margin: 20px 0; border-radius: 6px; background: var(--sel); }
  .fx .boot-sidebar span:last-child { width: 65%; }
  .fx .boot-content { display: flex; flex: 1; min-height: 0; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 32px 20px; text-align: center; }
  .fx .boot-content > p { max-width: 42ch; }
  .fx .boot-content > a { margin-top: 8px; text-decoration: underline; text-underline-offset: 3px; }
  .fx .boot-placeholder { width: 56px; height: 56px; margin-bottom: 8px; border: 1px solid var(--line-2); border-radius: 16px; background: var(--field); }
  .fx .boot-failure { grid-column: 1 / -1; margin-left: 6px; }
  @media (max-width: 860px) {
    .fx .boot-sidebar { display: none; }
    .fx .boot-main { grid-column: 1 / -1; margin-left: 6px; }
  }
  .fx[data-theme="dark"] {
    color-scheme: dark;
    --bg: #0d0e10; --panel: #15161a; --sub: #1a1b20; --field: #1f2026; --hover: #23242a; --sel: #2a2b32;
    --text: #ecebe8; --muted: #a1a1a8; --dim: #6f7078; --line: #26272d; --line-2: #33343b; --ink: #ecebe8; --on-ink: #111;
    --shadow: 0 18px 50px -20px rgba(0, 0, 0, 0.7);
  }
  @media (prefers-color-scheme: dark) {
    /* Before account preferences arrive, use the system theme without storing
       or exposing a previous customer's preferences. */
    .fx:not([data-theme]) {
      color-scheme: dark;
      --bg: #0d0e10; --panel: #15161a; --sub: #1a1b20; --field: #1f2026; --hover: #23242a; --sel: #2a2b32;
      --text: #ecebe8; --muted: #a1a1a8; --dim: #6f7078; --line: #26272d; --line-2: #33343b; --ink: #ecebe8; --on-ink: #111;
    }
  }
  .fx * { box-sizing: border-box; }
  .fx button { font: inherit; color: inherit; }
  .fx a { color: inherit; text-decoration: none; }
  .fx svg { display: inline-block; flex: none; }
  .fx [hidden] { display: none !important; }
  .fx :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .fx .mono { font-family: var(--mono); }
  .fx .muted { color: var(--muted); }
  .fx .dim { color: var(--dim); }
  .fx .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  /* Sidebar */
  .fx .sb { display: flex; flex-direction: column; min-height: 0; min-width: 0; padding: 10px 10px 12px; gap: 2px; overflow: hidden; }
  .fx .ws-btn { display: flex; align-items: center; gap: 9px; width: 100%; padding: 8px 10px; border: 0; border-radius: 10px; background: none; cursor: pointer; font-size: 15px; font-weight: 600; text-align: left; }
  .fx .ws-btn:hover { background: var(--hover); }
  .fx .ws-btn > span:not(.ws-ic) { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fx .ws-btn .chev { margin-left: auto; color: var(--dim); }
  .fx .ws-ic { width: 24px; height: 24px; flex: none; display: grid; place-items: center; border-radius: 7px; background: var(--ink); color: var(--on-ink); font-size: 12px; font-weight: 700; }
  .fx .ws-ic.none { background: var(--field); color: var(--dim); }
  .fx .tag { display: inline-flex; align-items: center; height: 20px; padding: 0 7px; border-radius: 6px; background: var(--field); color: var(--muted); font-size: 11.5px; font-weight: 550; white-space: nowrap; }
  .fx .navlist { list-style: none; margin: 6px 0 0; padding: 0; display: flex; flex-direction: column; gap: 1px; }
  .fx .ni { display: flex; align-items: center; gap: 10px; width: 100%; height: 36px; padding: 0 10px; border: 0; border-radius: 9px; background: none; cursor: pointer; text-align: left; color: var(--text); font-size: 14px; }
  .fx .ni:hover { background: var(--hover); }
  .fx .ni[aria-current="page"] { background: var(--sel); font-weight: 550; }
  .fx .ni[aria-disabled="true"] { color: var(--dim); }
  .fx .ni .end { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; color: var(--dim); font-size: 12px; font-weight: 400; }
  .fx .sub-nav { margin: 0 0 4px 19px; padding-left: 8px; border-left: 1px solid var(--line); }
  .fx .sec-h { display: flex; align-items: center; justify-content: space-between; margin: 14px 4px 2px 10px; color: var(--dim); font-size: 12.5px; }
  .fx .icon-btn { width: 30px; height: 30px; flex: none; display: inline-grid; place-items: center; border: 0; border-radius: 8px; background: none; cursor: pointer; color: var(--muted); }
  .fx .icon-btn:hover { background: var(--hover); color: var(--text); }
  .fx .chats { flex: 1; min-height: 40px; overflow: auto; margin: 0 -4px; padding: 0 4px; }
  .fx .chat-i { display: flex; align-items: center; gap: 10px; width: 100%; height: 34px; padding: 0 10px; border: 0; border-radius: 9px; background: none; cursor: pointer; text-align: left; font-size: 13.5px; }
  .fx .chat-i span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fx .chat-i:hover { background: var(--hover); }
  .fx .chat-i[aria-current="page"] { background: var(--sel); font-weight: 550; }
  .fx .empty-note { margin: 4px 10px; color: var(--dim); font-size: 13px; }
  .fx .glyph { width: 18px; height: 18px; flex: none; display: inline-grid; place-items: center; border-radius: 5px; font-size: 12px; font-weight: 700; color: var(--hue); }
  .fx .promo { position: relative; flex: none; margin: 8px 0 4px; padding: 14px; border-radius: 14px; color: #fff; background: radial-gradient(120% 90% at 100% 0%, #3b2c6b, transparent 60%), radial-gradient(90% 80% at 0% 100%, #5a2a1c, transparent 60%), #111217; overflow: hidden; }
  .fx .promo::after { content: ""; position: absolute; inset: 0; background-image: radial-gradient(rgba(255,255,255,.5) 1px, transparent 1px); background-size: 22px 22px; opacity: .12; pointer-events: none; }
  .fx .promo .pk { font: 500 10.5px var(--mono); letter-spacing: .14em; opacity: .7; }
  .fx .promo b { display: block; margin-top: 8px; font-size: 15px; }
  .fx .promo p { margin: 4px 0 12px; font-size: 12.5px; opacity: .8; }
  .fx .promo .x { position: absolute; top: 6px; right: 6px; z-index: 1; color: #fff; }
  .fx .promo .x:hover { background: rgba(255,255,255,.12); color: #fff; }
  .fx .promo .go { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; width: 100%; height: 30px; padding: 0 12px; border: 0; border-radius: 8px; background: #fff; color: #111; font-weight: 600; cursor: pointer; }
  .fx .me { display: flex; align-items: center; gap: 2px; flex: none; margin-top: 6px; }
  .fx .me-btn { flex: 1; display: flex; align-items: center; gap: 10px; min-width: 0; padding: 6px 8px; border: 0; border-radius: 10px; background: none; cursor: pointer; text-align: left; }
  .fx .me-btn:hover { background: var(--hover); }
  .fx .me-btn b { display: block; font-weight: 550; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fx .me-btn small { display: block; color: var(--muted); font-size: 12px; }
  .fx .av { width: 32px; height: 32px; flex: none; border-radius: 50%; display: grid; place-items: center; color: #fff; font-size: 12px; font-weight: 650; background: var(--av, linear-gradient(135deg, #d9b98a, #a97c50)); background-size: cover; background-position: center; }
  .fx .av.sm { width: 24px; height: 24px; font-size: 10.5px; }
  .fx .av.lg { width: 72px; height: 72px; font-size: 24px; }

  /* Main panel */
  .fx .main { min-width: 0; min-height: 0; margin: 6px 6px 6px 0; border-radius: 14px; border: 1px solid var(--line); background: var(--panel); display: flex; flex-direction: column; overflow: hidden; }
  .fx.sb-hidden .main { margin-left: 6px; }
  .fx .bar { display: flex; align-items: center; gap: 10px; min-height: 52px; padding: 8px 16px; border-bottom: 1px solid var(--line); flex: none; }
  .fx .bar h1 { margin: 0; font-size: 14.5px; font-weight: 600; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fx .bar .ttl { min-width: 0; }
  .fx .bar small { display: block; color: var(--muted); font-size: 12px; font-weight: 400; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fx .bar .r { margin-left: auto; display: flex; align-items: center; gap: 8px; flex: none; }
  .fx .bar.clean { border-bottom-color: transparent; }
  .fx .scroll { flex: 1; min-height: 0; overflow: auto; }
  .fx .page { width: min(1100px, 100%); margin: 0 auto; padding: 28px 24px 64px; }
  .fx .page.narrow { width: min(760px, 100%); }
  .fx .strip { display: flex; align-items: center; gap: 8px; flex: none; padding: 7px 14px; font-size: 12.5px; color: var(--muted); background: var(--sub); border-bottom: 1px solid var(--line); }
  .fx .strip i { width: 6px; height: 6px; border-radius: 50%; background: var(--warn); flex: none; }
  .fx .strip .r { margin-left: auto; display: flex; gap: 6px; flex: none; }
  .fx .strip span { min-width: 0; }

  /* Controls */
  .fx .btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; height: 34px; padding: 0 14px; border-radius: 9px; border: 1px solid var(--line-2); background: var(--panel); cursor: pointer; font-weight: 550; font-size: 13.5px; white-space: nowrap; text-decoration: none; }
  .fx .btn:hover { background: var(--hover); }
  .fx .btn.pri { background: var(--ink); color: var(--on-ink); border-color: var(--ink); }
  .fx .btn.pri:hover { opacity: .88; }
  .fx .btn.soft { background: var(--field); border-color: transparent; }
  .fx .btn.danger { background: var(--bad); border-color: var(--bad); color: #fff; }
  .fx .btn.sm { height: 28px; padding: 0 10px; font-size: 12.5px; border-radius: 7px; }
  .fx .btn.wide { width: 100%; }
  .fx .btn[disabled] { opacity: .45; cursor: not-allowed; }
  .fx input[type=text], .fx input[type=email], .fx input[type=number], .fx input[type=search], .fx input[type=time], .fx input[type=password], .fx textarea, .fx select {
    width: 100%; height: 36px; padding: 0 12px; border-radius: 9px; border: 1px solid transparent; background: var(--field); color: var(--text); font: inherit; outline: none;
  }
  .fx textarea { height: auto; padding: 10px 12px; resize: vertical; }
  .fx input:focus, .fx textarea:focus, .fx select:focus { border-color: var(--line-2); background: var(--panel); }
  .fx .f { display: flex; flex-direction: column; gap: 6px; font-weight: 550; font-size: 13.5px; }
  .fx .f small, .fx .hint { color: var(--muted); font-weight: 400; font-size: 12.5px; }
  .fx .err { color: var(--bad); font-size: 12.5px; }
  .fx .seg { display: inline-flex; gap: 2px; padding: 3px; border-radius: 10px; background: var(--field); max-width: 100%; overflow-x: auto; }
  .fx .seg button { height: 28px; padding: 0 12px; border: 0; border-radius: 8px; background: none; cursor: pointer; color: var(--muted); font-weight: 550; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; }
  .fx .seg button[aria-selected="true"], .fx .seg button[aria-pressed="true"] { background: var(--panel); color: var(--text); box-shadow: 0 1px 2px rgba(0,0,0,.08); }
  .fx .card { border: 1px solid var(--line); border-radius: var(--r); background: var(--panel); }
  .fx .card.pad { padding: 18px 20px; }
  .fx .card.sub { background: var(--sub); }
  .fx .grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .fx .grid3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .fx .grid4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .fx h2.t { margin: 0; font-size: 22px; font-weight: 600; letter-spacing: -0.02em; }
  .fx h3 { margin: 0; font-size: 15px; font-weight: 600; }
  .fx h4 { margin: 0; font-size: 13.5px; font-weight: 600; }
  .fx p { margin: 0; }
  .fx .k { font: 500 11px var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--dim); }
  .fx .row { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .fx .row.wrap { flex-wrap: wrap; }
  .fx .between { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-width: 0; }
  .fx .card.between { flex-wrap: wrap; }
  .fx .stack { display: flex; flex-direction: column; gap: 12px; }
  .fx .stack.lg { gap: 28px; }
  .fx .sec-title { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin: 0 0 12px; }
  .fx .sec-title h3 { font-size: 16px; }
  .fx .pill { display: inline-flex; align-items: center; gap: 6px; height: 24px; padding: 0 9px; border-radius: 999px; background: var(--field); font-size: 12px; color: var(--muted); white-space: nowrap; }
  .fx .pill.ok { background: color-mix(in srgb, var(--ok) 14%, transparent); color: var(--ok); }
  .fx .pill.warn { background: color-mix(in srgb, var(--warn) 14%, transparent); color: var(--warn); }
  .fx .meter { display: flex; gap: 3px; margin-top: 8px; }
  .fx .meter i { flex: 1; height: 5px; border-radius: 3px; background: var(--line); }
  .fx .meter i.on { background: var(--hue, #6e7bff); }
  .fx .empty { display: grid; justify-items: center; text-align: center; gap: 8px; padding: 56px 20px; color: var(--muted); }
  .fx .empty h3 { color: var(--text); font-size: 17px; }
  .fx .empty p { max-width: 46ch; }
  .fx .empty .ico { width: 48px; height: 48px; display: grid; place-items: center; border-radius: 14px; background: var(--field); color: var(--text); margin-bottom: 4px; }
  .fx .empty .btn { margin-top: 8px; }
  .fx .dark-hero { position: relative; padding: 32px 36px; border-radius: 18px; background: #0f1013; color: #f1f0ec; overflow: hidden; }
  .fx .dark-hero::after { content: ""; position: absolute; inset: 0; background-image: radial-gradient(rgba(255,255,255,.35) 1px, transparent 1px); background-size: 24px 24px; opacity: .08; pointer-events: none; }
  .fx .dark-hero > * { position: relative; z-index: 1; }
  .fx .dark-hero .k { color: #9a9aa0; }
  .fx .dark-hero h2 { margin: 10px 0 8px; font-size: 28px; font-weight: 650; letter-spacing: -0.03em; max-width: 22ch; }
  .fx .dark-hero p { max-width: 56ch; color: #b9b8b3; }
  .fx .dark-hero ul { list-style: none; padding: 0; margin: 20px 0 0; display: flex; flex-wrap: wrap; gap: 10px 22px; font-size: 13.5px; max-width: 60%; }
  .fx .dark-hero li::before { content: "✓ "; color: #86d6ad; }
  .fx .dark-hero .meta { margin-top: 18px; color: #8d8c88; font-size: 12.5px; }
  .fx .tile-art { position: absolute !important; right: 36px; top: 50%; transform: translateY(-50%); display: grid; grid-template-columns: repeat(3, 46px); gap: 10px; }
  .fx .tile-art span { width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center; font-weight: 700; background: #1d1e23; border: 1px solid #2c2d33; color: var(--hue); }
  .fx .tile-art span svg { width: 22px; height: 22px; }
  .fx .tile-art span:nth-child(odd) { transform: translateY(8px); }
  .fx .crumbs { display: flex; align-items: center; gap: 6px; color: var(--muted); font-size: 13px; }
  .fx .crumbs button { border: 0; background: none; padding: 2px 4px; border-radius: 6px; cursor: pointer; color: var(--muted); }
  .fx .crumbs button:hover { background: var(--hover); color: var(--text); }
  .fx .crumbs b { color: var(--text); font-weight: 550; }

  /* Home */
  .fx .welcome { display: grid; gap: 22px; padding-top: 6vh; }
  .fx .welcome h2 { font-size: 30px; letter-spacing: -0.03em; }
  .fx .wcard { display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--line); border-radius: 18px; background: var(--panel); text-align: left; cursor: pointer; padding: 0; }
  .fx .wcard:hover { border-color: var(--line-2); box-shadow: 0 14px 36px -24px rgba(0,0,0,.3); }
  .fx .wcard .art { position: relative; height: 170px; background: var(--sub); border-bottom: 1px solid var(--line); overflow: hidden; }
  .fx .wcard .body { padding: 18px 20px 20px; display: grid; gap: 6px; }
  .fx .wcard .body p { color: var(--muted); }
  .fx .wcard .body .btn { justify-self: start; margin-top: 8px; }
  .fx .art-win { position: absolute; left: 24px; right: 24px; top: 26px; bottom: -10px; border-radius: 12px; background: var(--panel); border: 1px solid var(--line); box-shadow: 0 10px 30px -18px rgba(0,0,0,.3); padding: 14px; display: grid; grid-template-columns: 70px 1fr; gap: 12px; }
  .fx .art-win i { display: block; height: 7px; border-radius: 4px; background: var(--line); margin-bottom: 8px; }
  .fx .art-win .side i:first-child { background: var(--accent); width: 60%; }
  .fx .art-win .msg { display: flex; gap: 8px; align-items: flex-start; margin-bottom: 10px; }
  .fx .art-win .msg b { width: 16px; height: 16px; border-radius: 5px; flex: none; background: var(--hue); }
  .fx .art-win .msg span { flex: 1; }
  .fx .art-orbit { position: absolute; inset: 0; display: grid; place-items: center; }
  .fx .art-orbit .ring { position: absolute; width: 220px; height: 220px; border-radius: 50%; border: 1px dashed var(--line-2); }
  .fx .art-orbit .core { width: 64px; height: 64px; border-radius: 18px; background: var(--ink); color: var(--on-ink); display: grid; place-items: center; font-size: 26px; font-weight: 700; box-shadow: 0 18px 30px -16px rgba(0,0,0,.5); }
  .fx .art-orbit .sat { position: absolute; display: grid; place-items: center; border-radius: 11px; background: var(--panel); box-shadow: 0 6px 16px -10px rgba(0,0,0,.35); }

  /* Popovers and dialogs */
  .fx .pop { position: fixed; z-index: 60; min-width: 230px; max-width: min(340px, calc(100vw - 16px)); max-height: min(560px, calc(100vh - 16px)); overflow: auto; padding: 6px; border-radius: 12px; border: 1px solid var(--line); background: var(--panel); box-shadow: var(--shadow); animation: fx-fade .12s ease; }
