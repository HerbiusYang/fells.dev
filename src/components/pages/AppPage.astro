  .fx .currency-quote dt { color: var(--muted); }
  .fx .currency-quote dd { margin: 0; text-align: right; overflow-wrap: anywhere; }
  .fx .dlg .foot { display: flex; justify-content: flex-end; gap: 8px; margin-top: 22px; }
  .fx .dlg .foot.between { justify-content: space-between; }
  @keyframes fx-fade { from { opacity: 0; } }
  @keyframes fx-rise { from { opacity: 0; transform: translateY(8px) scale(.98); } }
  .fx .toast { position: fixed; left: 50%; bottom: 24px; z-index: 90; transform: translateX(-50%); max-width: calc(100vw - 32px); padding: 10px 16px; border-radius: 10px; background: var(--ink); color: var(--on-ink); font-size: 13.5px; box-shadow: var(--shadow); animation: fx-fade .2s ease; }
  .fx .opts { display: flex; flex-direction: column; gap: 8px; }
