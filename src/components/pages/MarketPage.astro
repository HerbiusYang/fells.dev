---
import type { Dict } from "../../i18n/en";
import { pagesOf, fmtOff } from "../../i18n/index";
import { channels, models, offPct, type Channel, type Level } from "../../data/catalog";
import PageShell from "../PageShell.astro";
import PageHero from "../PageHero.astro";
import Plans from "../Plans.astro";
interface Props { t: Dict }
const { t } = Astro.props;
const m = pagesOf(t).market;
const subs = channels.filter((c) => c.kind === "sub");
const paygs = channels.filter((c) => c.kind === "payg");
const levelName: Record<Level, string> = { 1: m.levels.low, 2: m.levels.mid, 3: m.levels.high, 4: m.levels.great };
const metricKeys = ["value", "privacy", "capability", "speed"] as const;
const own = (c: Channel) => (m.channels as Record<string, { name: string; by: string; desc: string; note: string } | undefined>)[c.id];
const nameOf = (c: Channel) => own(c)?.name ?? c.name ?? c.id;
const byOf = (c: Channel) => own(c)?.by ?? c.name ?? "";
const descOf = (c: Channel) => own(c)?.desc ?? (c.style === "direct" ? m.directDesc : m.providerDesc).replace("{name}", c.name ?? "");
const noteOf = (c: Channel) => own(c)?.note ?? (c.style === "direct" ? m.sameAsList.replace("{name}", c.name ?? "") : "");
const priceOf = (c: Channel) =>
  c.kind === "sub" ? `${m.from} $${c.from} ${m.perMonth}` : `${m.inputFrom} $${c.from} ${m.perM}`;
const providers = [...new Set(models.map((x) => x.provider))];
const fmt = (n: number) => `$${n.toFixed(2)}`;
---
<PageShell t={t} slug="market" title={m.metaTitle} description={m.metaDescription}>
  <PageHero kicker={m.kicker} title={m.title} sub={m.sub}>
    <ul class="trust">
      {m.trust.map((x) => <li>{x}</li>)}
    </ul>
  </PageHero>

  <section class="market" data-market data-view="cards" data-tab="channels" data-kind="all">
    <div class="wrap">
      <div class="bar">
        <div class="seg" role="tablist">
          <button type="button" role="tab" aria-selected="true" data-set-tab="channels">{m.tabChannels} <small>{channels.length}</small></button>
          <button type="button" role="tab" aria-selected="false" data-set-tab="models">{m.tabModels} <small>{models.length}</small></button>
        </div>
        <div class="tools" data-only="channels">
          <div class="chips" role="group">
            <button type="button" aria-pressed="true" data-set-kind="all">{m.filterAll} <small>{channels.length}</small></button>
            <button type="button" aria-pressed="false" data-set-kind="sub">{m.filterSub} <small>{subs.length}</small></button>
            <button type="button" aria-pressed="false" data-set-kind="payg">{m.filterPayg} <small>{paygs.length}</small></button>
          </div>
          <div class="seg small" role="group">
            <button type="button" aria-pressed="true" data-set-view="cards">{m.viewCards}</button>
            <button type="button" aria-pressed="false" data-set-view="compare">{m.viewCompare}</button>
          </div>
        </div>
      </div>

      <div data-only="channels">
        {[
          { kind: "sub", title: m.subsTitle, sub: m.subsSub, list: subs },
          { kind: "payg", title: m.paygTitle, sub: m.paygSub, list: paygs },
        ].map((g) => (
          <div class="group" data-group={g.kind}>
            <header>
              <h2>{g.title} <small>{g.list.length}</small></h2>
              <p>{g.sub}</p>
            </header>
            <ul class="cards" data-only-view="cards">
              {g.list.map((c) => (
                <li class="card" style={`--hue:${c.hue}`}>
                  <div class="top">
                    <span class="mark" aria-hidden="true">{nameOf(c).slice(0, 1)}</span>
                    <div>
                      <h3>{nameOf(c)}</h3>
                      <p class="by">{c.kind === "sub" ? m.kindSub : m.kindPayg} · {byOf(c)}</p>
                    </div>
                    {c.badge && <span class:list={["badge", c.badge]}>{c.badge === "recommended" ? m.recommended : m.default}</span>}
                  </div>
                  <p class="verified">✓ {m.verified}</p>
                  <p class="desc">{descOf(c)}</p>
                  <dl class="metrics">
                    {metricKeys.map((k) => (
                      <div>
                        <dt>{m.metrics[k]}</dt>
                        <dd>
                          <span class="pips" aria-hidden="true">
                            {[1, 2, 3, 4].map((i) => <i class:list={{ on: i <= c.metrics[k] }}></i>)}
                          </span>
                          {levelName[c.metrics[k]]}
                        </dd>
                      </div>
                    ))}
                  </dl>
                  <ul class="models">
                    {c.models.slice(0, 2).map((x) => <li>{x}</li>)}
                    {c.total > Math.min(2, c.models.length) && <li class="more">{m.more.replace("{n}", String(c.total - Math.min(2, c.models.length)))}</li>}
                  </ul>
                  <div class="foot">
                    <b>{priceOf(c)}</b>
                    {noteOf(c) && <span>{noteOf(c)}</span>}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <div class="compare" data-only-view="compare">
          <table>
            <thead>
              <tr>
                <th scope="col">{m.compareCols.channel}</th>
                <th scope="col">{m.compareCols.kind}</th>
                {metricKeys.map((k) => <th scope="col">{m.metrics[k]}</th>)}
                <th scope="col">{m.compareCols.models}</th>
                <th scope="col">{m.compareCols.price}</th>
              </tr>
            </thead>
            <tbody>
              {channels.map((c) => (
                <tr data-kind={c.kind} style={`--hue:${c.hue}`}>
                  <th scope="row"><span class="dot"></span>{nameOf(c)}</th>
                  <td>{c.kind === "sub" ? m.kindSub : m.kindPayg}</td>
                  {metricKeys.map((k) => (
                    <td><span class="pips" aria-label={levelName[c.metrics[k]]}>{[1, 2, 3, 4].map((i) => <i class:list={{ on: i <= c.metrics[k] }}></i>)}</span></td>
                  ))}
                  <td>{c.total}</td>
                  <td class="num">{priceOf(c)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div data-only="models" class="models-tab">
        <header>
          <h2>{m.modelsTitle}</h2>
          <p>{m.modelsSub}</p>
        </header>
        <div class="filters" role="group">
          <button type="button" aria-pressed="true" data-provider-filter="">{m.filterAll}</button>
          {providers.map((p) => <button type="button" aria-pressed="false" data-provider-filter={p}>{p}</button>)}
        </div>
        <div class="mgrid">
          {models.map((x) => {
            const off = offPct(x.input, x.refInput);
            return (
              <article class="mcard" data-provider={x.provider}>
                <p class="prov">{x.provider}</p>
                <h3>{x.name}</h3>
                {x.tag === "new" && <span class="tag new">{t.payg.new}</span>}
                {x.tag === "long" && <span class="tag long">{t.payg.long}</span>}
                <dl>
                  <div><dt>{t.payg.input}</dt><dd><b>{fmt(x.input)}</b>{off > 0 && <s>{fmt(x.refInput)}</s>}</dd></div>
                  <div><dt>{t.payg.output}</dt><dd><b>{fmt(x.output)}</b>{off > 0 && <s>{fmt(x.refOutput)}</s>}</dd></div>
                </dl>
                <span class:list={["tag", off > 0 ? "off" : "same"]}>{off > 0 ? fmtOff(t, off) : t.payg.same}</span>
              </article>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <Plans t={t} />
</PageShell>

<style>
  .trust { list-style: none; padding: 0; margin: 32px 0 0; display: flex; flex-wrap: wrap; gap: 10px 22px; font-size: 14px; color: var(--muted); }
  .trust li::before { content: "✓"; color: var(--moss); margin-right: 8px; }

  .market { padding-bottom: 40px; }
  .bar { position: sticky; top: 68px; z-index: 5; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding: 12px 0; margin-bottom: 8px; background: linear-gradient(var(--bg) 70%, transparent); }
  .tools { display: flex; gap: 10px; flex-wrap: wrap; }
  .seg, .chips { display: inline-flex; gap: 4px; padding: 4px; border-radius: 999px; border: 1px solid var(--line); background: var(--panel); }
  .chips { border: 0; background: none; padding: 0; gap: 6px; }
  .seg button, .chips button, .filters button {
    border: 1px solid transparent; background: transparent; color: var(--muted); border-radius: 999px; padding: 8px 14px; font-size: 14px; cursor: pointer; white-space: nowrap; transition: color 0.2s, background 0.2s;
  }
  .chips button, .filters button { border-color: var(--line); padding: 7px 13px; font-size: 13px; }
  .seg.small button { padding: 6px 12px; font-size: 13px; }
  button small { color: var(--dim); margin-left: 4px; font: 500 12px var(--mono); }
  .seg button:hover, .chips button:hover, .filters button:hover { color: var(--text); }
  .seg [aria-selected="true"], .seg [aria-pressed="true"] { background: var(--panel-2); color: var(--text); }
  .chips [aria-pressed="true"], .filters [aria-pressed="true"] { border-color: rgba(243, 163, 127, 0.45); color: var(--text); background: rgba(224, 122, 85, 0.1); }

  .group { margin-top: 40px; }
  .group header h2, .models-tab h2 { margin: 0; font-size: 22px; font-weight: 600; letter-spacing: -0.02em; }
  .group header small { font: 500 13px var(--mono); color: var(--dim); margin-left: 6px; }
  .group header p, .models-tab header p { margin: 8px 0 0; color: var(--muted); max-width: 80ch; font-size: 15px; }

  .cards { list-style: none; padding: 0; margin: 22px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .card {
    position: relative; display: flex; flex-direction: column; padding: 22px; border-radius: var(--radius-lg); border: 1px solid var(--line); overflow: hidden;
    background: radial-gradient(120% 60% at 0% 0%, color-mix(in srgb, var(--hue) 12%, transparent), transparent 60%), var(--panel);
    transition: border-color 0.3s, transform 0.3s var(--ease);
  }
  .card:hover { border-color: color-mix(in srgb, var(--hue) 45%, var(--line)); transform: translateY(-2px); }
  .top { display: flex; align-items: flex-start; gap: 12px; }
  .top > div { flex: 1; min-width: 0; }
  .mark { flex: none; width: 38px; height: 38px; border-radius: 11px; display: grid; place-items: center; font-weight: 650; color: #0b0d11; background: var(--hue); }
  h3 { margin: 0; font-size: 17px; font-weight: 600; }
  .by { margin: 3px 0 0; font-size: 13px; color: var(--dim); }
  .badge { font: 500 12px var(--mono); padding: 3px 8px; border-radius: 999px; white-space: nowrap; }
  .badge.recommended { background: rgba(224, 122, 85, 0.16); color: var(--ember-2); }
  .badge.default { background: rgba(134, 214, 173, 0.14); color: var(--moss); }
  .verified { margin: 14px 0 0; font-size: 12.5px; color: var(--moss); }
  .desc { margin: 8px 0 0; font-size: 14px; color: var(--muted); }
  .metrics { margin: 16px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px; }
  .metrics div { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 12.5px; }
  .metrics dt { color: var(--dim); }
  .metrics dd { margin: 0; display: inline-flex; align-items: center; gap: 7px; color: var(--muted); }
  .pips { display: inline-flex; gap: 3px; }
  .pips i { width: 10px; height: 4px; border-radius: 2px; background: var(--line-2); }
  .pips i.on { background: var(--hue, var(--ember)); }
  .models { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .models li { font-size: 12.5px; padding: 4px 9px; border-radius: 7px; border: 1px solid var(--line); color: var(--muted); }
  .models .more { color: var(--dim); border-style: dashed; }
  .foot { margin-top: auto; padding-top: 18px; display: flex; flex-direction: column; gap: 3px; }
  .foot b { font-size: 16px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .foot span { font-size: 12.5px; color: var(--moss); }

  .compare { margin-top: 32px; border-radius: var(--radius-lg); border: 1px solid var(--line-2); overflow-x: auto; background: #0b0d11; }
  .compare table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 860px; }
  .compare th, .compare td { padding: 13px 16px; text-align: left; font-weight: 400; white-space: nowrap; }
  .compare thead th { font-size: 12px; color: var(--dim); text-transform: uppercase; letter-spacing: 0.06em; }
  .compare tbody tr { border-top: 1px solid var(--line); }
  .compare tbody th { font-weight: 550; }
  .compare tr[hidden] { display: none; }
  .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--hue); margin-right: 10px; }
  .num { font-variant-numeric: tabular-nums; }

  [data-view="cards"] [data-only-view="compare"],
  [data-view="compare"] [data-only-view="cards"],
  [data-view="compare"] .group header p,
  [data-tab="channels"] [data-only="models"],
  [data-tab="models"] [data-only="channels"],
  [data-kind="sub"] [data-group="payg"],
  [data-kind="payg"] [data-group="sub"] { display: none; }
  [data-view="compare"] .group { margin-top: 24px; }
  [data-view="compare"] .group + .group { display: none; }

  .models-tab { margin-top: 32px; }
  .filters { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 6px; }
  .mgrid { margin-top: 20px; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
  .mcard { position: relative; padding: 18px; border-radius: 16px; border: 1px solid var(--line); background: var(--panel); }
  .mcard[hidden] { display: none; }
  .prov { margin: 0; font-size: 12px; color: var(--dim); }
  .mcard h3 { margin: 4px 0 0; font-size: 16px; }
  .mcard dl { margin: 14px 0 12px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .mcard dt { font-size: 12px; color: var(--dim); text-transform: uppercase; letter-spacing: 0.06em; }
  .mcard dd { margin: 2px 0 0; display: flex; align-items: baseline; gap: 6px; }
  .mcard dd b { font-variant-numeric: tabular-nums; font-weight: 600; }
  .mcard dd s { font-size: 12px; color: var(--dim); }
  .mcard > .tag.new, .mcard > .tag.long { position: absolute; top: 16px; right: 16px; }
  .tag { display: inline-block; font: 500 12px var(--mono); padding: 2px 6px; border-radius: 5px; }
  .tag.off { background: rgba(224, 122, 85, 0.15); color: var(--ember-2); }
  .tag.same { background: var(--panel-2); color: var(--dim); }
  .tag.new { background: rgba(134, 214, 173, 0.15); color: var(--moss); }
  .tag.long { background: rgba(124, 140, 255, 0.15); color: var(--violet); }

  @media (max-width: 640px) {
    .bar { position: static; }
    .cards { grid-template-columns: 1fr; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-market]").forEach((root) => {
    const press = (sel: string, on: Element) =>
      root.querySelectorAll(sel).forEach((b) => b.setAttribute(b.getAttribute("role") === "tab" ? "aria-selected" : "aria-pressed", String(b === on)));
    root.querySelectorAll<HTMLElement>("[data-set-tab]").forEach((b) =>
      b.addEventListener("click", () => {
        root.dataset.tab = b.dataset.setTab;
        press("[data-set-tab]", b);
      }),
    );
    root.querySelectorAll<HTMLElement>("[data-set-view]").forEach((b) =>
      b.addEventListener("click", () => {
        root.dataset.view = b.dataset.setView;
        press("[data-set-view]", b);
      }),
    );
    root.querySelectorAll<HTMLElement>("[data-set-kind]").forEach((b) =>
      b.addEventListener("click", () => {
        const kind = b.dataset.setKind!;
        root.dataset.kind = kind;
        press("[data-set-kind]", b);
        root.querySelectorAll<HTMLElement>(".compare tbody tr").forEach((tr) => (tr.hidden = kind !== "all" && tr.dataset.kind !== kind));
      }),
    );
    root.querySelectorAll<HTMLElement>("[data-provider-filter]").forEach((b) =>
      b.addEventListener("click", () => {
        const p = b.dataset.providerFilter;
        press("[data-provider-filter]", b);
        root.querySelectorAll<HTMLElement>(".mcard").forEach((c) => (c.hidden = !!p && c.dataset.provider !== p));
      }),
    );
  });
</script>
