---
import { agentMarks } from "../../data/icons";
import type { Dict } from "../../i18n/en";
import { pagesOf } from "../../i18n/index";
import PageShell from "../PageShell.astro";
interface Props { t: Dict }
const { t } = Astro.props;
const b = pagesOf(t).blog;
const cats = ["product", "agents", "models"] as const;
const hue = { product: "#86d6ad", agents: "#e07a55", models: "#a8a4ff" };
---
<PageShell t={t} slug="blog" title={b.metaTitle} description={b.metaDescription}>
  <section class="bhero" data-blog>
    <div class="wrap">
      <h1>{b.title}</h1>
      <nav class="cats" aria-label={b.title}>
        <button type="button" aria-pressed="true" data-cat="">{b.cats.all}</button>
        {cats.map((c) => <button type="button" aria-pressed="false" data-cat={c}>{b.cats[c]}</button>)}
      </nav>

      <article class="featured reveal" data-section="product">
        <div class="art" aria-hidden="true">
          <div class="contours"></div>
          {["claude", "codex", "opencode"].map((id) => <span style={`color:${agentMarks[id].hue}`} set:html={agentMarks[id].svg} />)}
        </div>
        <div class="ftxt">
          <p class="k">{b.featuredLabel}</p>
          <h2>{b.featured.title}</h2>
          <p>{b.featured.body}</p>
          <small>{b.featured.date}</small>
        </div>
      </article>

      {cats.map((c, i) => (
        <section class="cat" data-section={c} style={`--hue:${hue[c]}`}>
          <header class="reveal">
            <p class="k">0{i + 1} · {b.sections[c].kicker}</p>
            <h2>{b.cats[c]}</h2>
            <p>{b.sections[c].sub}</p>
          </header>
          <div class="posts">
            {b.posts.filter((p) => p.cat === c).map((p, j) => (
              <article class="post reveal" style={`transition-delay:${j * 60}ms`}>
                <p class="tag">{b.cats[c]}</p>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
                <small>{p.date} · {pagesOf(t).common.soon}</small>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</PageShell>
<style>
  .bhero { padding: clamp(64px, 9vw, 112px) 0 40px; }
  h1 { margin: 0; font-size: clamp(44px, 7vw, 88px); letter-spacing: -0.04em; font-weight: 650; }
  .cats { margin-top: 28px; display: flex; gap: 6px; flex-wrap: wrap; }
  .cats button { border: 1px solid var(--line); background: transparent; color: var(--muted); border-radius: 999px; padding: 8px 16px; font-size: 14px; cursor: pointer; }
  .cats button:hover { color: var(--text); }
  .cats button[aria-pressed="true"] { background: var(--text); color: #0b0d11; border-color: var(--text); }
  .featured { margin-top: 40px; display: grid; grid-template-columns: 1.1fr 1fr; border-radius: var(--radius-lg); border: 1px solid var(--line-2); overflow: hidden; background: var(--panel); }
  .art { position: relative; isolation: isolate; min-height: 280px; display: flex; align-items: center; justify-content: center; gap: 18px; background: radial-gradient(60% 80% at 30% 30%, rgba(224, 122, 85, 0.3), transparent 70%), radial-gradient(60% 80% at 80% 80%, rgba(124, 140, 255, 0.25), transparent 70%), #0d1015; }
  .art span { width: 64px; height: 64px; border-radius: 18px; display: grid; place-items: center; font-size: 28px; background: rgba(255, 255, 255, 0.06); border: 1px solid var(--line-2); backdrop-filter: blur(8px); }
  .art span:nth-child(3) { transform: translateY(-16px); }
  .ftxt { padding: clamp(24px, 4vw, 44px); display: flex; flex-direction: column; justify-content: center; }
  .k { margin: 0; font: 500 12px var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--ember-2); }
  .ftxt h2 { margin: 14px 0 0; font-size: clamp(22px, 2.6vw, 30px); line-height: 1.2; letter-spacing: -0.02em; }
  .ftxt p:not(.k) { margin: 12px 0 0; color: var(--muted); }
  small { color: var(--dim); font-size: 12.5px; margin-top: 14px; display: block; }
  .cat { margin-top: clamp(56px, 8vw, 96px); }
  .cat .k { color: var(--hue); }
  .cat header h2 { margin: 10px 0 0; font-size: clamp(26px, 3vw, 36px); letter-spacing: -0.02em; }
  .cat header p:not(.k) { margin: 8px 0 0; color: var(--muted); max-width: 70ch; }
  .posts { margin-top: 28px; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
  .post { display: flex; flex-direction: column; padding: 22px; border-radius: 18px; border: 1px solid var(--line); background: var(--panel); transition: border-color 0.3s; }
  .post:hover { border-color: color-mix(in srgb, var(--hue) 40%, var(--line)); }
  .tag { margin: 0; font: 500 12px var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--hue); }
  .post h3 { margin: 10px 0 0; font-size: 17px; line-height: 1.35; font-weight: 600; }
  .post p:not(.tag) { margin: 8px 0 0; color: var(--muted); font-size: 14px; flex: 1; }
  [hidden] { display: none !important; }
  @media (max-width: 760px) { .featured { grid-template-columns: 1fr; } .art { min-height: 200px; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>("[data-blog]").forEach((root) => {
    const btns = [...root.querySelectorAll<HTMLButtonElement>("[data-cat]")];
    btns.forEach((b) =>
      b.addEventListener("click", () => {
        const c = b.dataset.cat;
        btns.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        root.querySelectorAll<HTMLElement>("[data-section]").forEach((s) => (s.hidden = !!c && s.dataset.section !== c));
      }),
    );
  });
</script>
