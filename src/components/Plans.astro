---
import type { Dict } from "../i18n/en";
interface Props { t: Dict }
const { t } = Astro.props;
const code = t.meta.lang.toLowerCase();
const copy = code.startsWith("zh-hant")
  ? { kicker: "線上客服購買", title: "聯絡客服購買服務", body: "客服會協助確認可購買的服務、價格和付款安排。", action: "聯絡客服購買" }
  : code.startsWith("zh")
    ? { kicker: "在线客服购买", title: "联系客服购买服务", body: "客服会协助确认可购买的服务、价格和付款安排。", action: "联系客服购买" }
    : code.startsWith("ja")
      ? { kicker: "オンラインサポート購入", title: "サポートからサービスを購入", body: "購入できるサービス、価格、お支払い方法をサポートにご確認ください。", action: "サポートに購入を相談" }
      : code.startsWith("ko")
        ? { kicker: "온라인 고객 지원 구매", title: "고객 지원을 통해 서비스 구매", body: "구매 가능한 서비스, 가격 및 결제 방법을 고객 지원에 문의해 주세요.", action: "고객 지원에 구매 문의" }
        : code.startsWith("es")
          ? { kicker: "Compra con atención al cliente", title: "Compra a través de atención al cliente", body: "Consulta los servicios disponibles, los precios y las opciones de pago con atención al cliente.", action: "Contactar para comprar" }
          : { kicker: "Purchase through online support", title: "Contact support to purchase", body: "Our team can confirm available services, prices and payment arrangements in chat.", action: "Contact support to purchase" };
---
<section class="section" id="plans">
  <div class="wrap">
    <div class="catalog-card reveal">
      <span class="kicker">{copy.kicker}</span>
      <h2 class="h2">{copy.title}</h2>
      <p class="lead">{copy.body}</p>
      <button class="btn btn-primary" type="button" data-open-customer-support>{copy.action}</button>
    </div>
  </div>
</section>
<style>
  .catalog-card { display: flex; flex-direction: column; align-items: flex-start; padding: clamp(28px, 5vw, 56px); border: 1px solid var(--line-2); border-radius: var(--radius-lg); background: linear-gradient(180deg, #11141a, #0b0d11); }
  .catalog-card .lead { max-width: 66ch; }
  .catalog-card .btn { margin-top: 14px; }
</style>
