---
import type { Dict } from "../i18n/en";
import { link } from "../i18n/index";
interface Props { t: Dict }
const { t } = Astro.props;
const code = t.meta.lang.toLowerCase();
const copy = code.startsWith("zh-hant")
  ? { kicker: "服務目錄", title: "查看目前開放的服務", body: "可售商品、價格和名額由帳戶服務即時提供。登入後請以結帳頁顯示的實際選項和金額為準。", action: "查看目前服務" }
  : code.startsWith("zh")
    ? { kicker: "服务目录", title: "查看当前开放的服务", body: "在售商品、价格和名额由账户服务实时提供。登录后请以结账页显示的实际选项和金额为准。", action: "查看当前服务" }
    : code.startsWith("ja")
      ? { kicker: "サービス一覧", title: "現在利用できるサービスを見る", body: "販売中の商品、価格、空き状況はアカウントのサービス一覧に表示されます。ログイン後、チェックアウト画面の内容をご確認ください。", action: "サービスを見る" }
      : code.startsWith("ko")
        ? { kicker: "서비스 목록", title: "현재 이용 가능한 서비스 보기", body: "판매 중인 상품, 가격, 이용 가능 여부는 계정의 서비스 목록에 표시됩니다. 로그인 후 결제 화면의 정보를 확인해 주세요.", action: "서비스 보기" }
        : code.startsWith("es")
          ? { kicker: "Catálogo", title: "Consulta los servicios disponibles", body: "Los productos, precios y disponibilidad actuales se muestran en el catálogo de tu cuenta. Inicia sesión para revisar las opciones reales antes de confirmar.", action: "Ver servicios" }
          : { kicker: "Service catalog", title: "See what is currently available", body: "Products, prices and availability come from your account's live service catalog. Sign in to review the actual options and total before confirming.", action: "View available services" };
---
<section class="section" id="plans">
  <div class="wrap">
    <div class="catalog-card reveal">
      <span class="kicker">{copy.kicker}</span>
      <h2 class="h2">{copy.title}</h2>
      <p class="lead">{copy.body}</p>
      <a class="btn btn-primary" href={link(t, "checkout")}>{copy.action}</a>
    </div>
  </div>
</section>
<style>
  .catalog-card { display: flex; flex-direction: column; align-items: flex-start; padding: clamp(28px, 5vw, 56px); border: 1px solid var(--line-2); border-radius: var(--radius-lg); background: linear-gradient(180deg, #11141a, #0b0d11); }
  .catalog-card .lead { max-width: 66ch; }
  .catalog-card .btn { margin-top: 14px; }
</style>
