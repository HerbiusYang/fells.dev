---
import type { Dict } from "../i18n/en";
import { businessRulesOf } from "../i18n/business-rules";
import { publicCatalogWordsOf } from "../i18n/public-catalog";
import PublicCatalog from "./PublicCatalog.astro";
interface Props { t: Dict }
const { t } = Astro.props;
const words = publicCatalogWordsOf(t.meta.lang);
const terms = businessRulesOf(t.meta.lang.toLowerCase());
---
<section class="section" id="plans">
  <div class="wrap">
    <div class="reveal"><span class="kicker">Token Plan</span><h2 class="h2">{words.tokens}</h2><p class="lead">{terms.tokenPlan}</p></div>
    <div class="catalog-space"><PublicCatalog t={t} kind="token_plans" /></div>
  </div>
</section>
<style>
  #plans { border-top: 1px solid var(--line); }
  .catalog-space { margin-top: 36px; }
</style>
