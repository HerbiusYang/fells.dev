---
import type { Dict } from "../i18n/en";
import { businessRulesOf } from "../i18n/business-rules";
import { publicCatalogWordsOf } from "../i18n/public-catalog";
import PublicCatalog from "./PublicCatalog.astro";
interface Props { t: Dict }
const { t } = Astro.props;
const words = publicCatalogWordsOf(t.meta.lang);
const terms = businessRulesOf(t.meta.lang.toLowerCase());
---
<section class="section group" id="group">
  <div class="wrap">
    <div class="reveal"><span class="kicker">{t.group.kicker}</span><h2 class="h2">{words.subscriptions}</h2><p class="lead">{terms.monthly}</p></div>
    <div class="catalog-space"><PublicCatalog t={t} kind="subscriptions" /></div>
  </div>
</section>
<style>
  .group { padding-top: 40px; }
  .catalog-space { margin-top: 32px; }
</style>
