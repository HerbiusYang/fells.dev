---
import type { Dict } from "../i18n/en";
import { deal } from "../i18n/index";
interface Props { t: Dict }
const { t } = Astro.props;
const { whatIs: w } = t;
---
<section class="section" id="what">
  <div class="wrap">
    <div class="head reveal">
      <span class="kicker">{w.kicker}</span>
      <h2 class="h2">{w.title}</h2>
      <p class="lead">{w.sub}</p>
    </div>
    <div class="parts">
      {w.parts.map((p, i) => (
        <a class:list={["part reveal", `p${i}`]} href={p.href} style={`transition-delay:${i * 100}ms`}>
          <div class="top">
            <span class="n">{p.n}</span>
            <span class="badge">{deal(t, p.badge)}</span>
          </div>
          <span class="label">{p.label}</span>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
          <span class="more">{p.cta} <span aria-hidden="true">→</span></span>
          <span class="art" aria-hidden="true">
            {i === 0 ? (
              <span class="bars"><i style="--h:38%"></i><i style="--h:62%"></i><i style="--h:48%"></i><i style="--h:84%"></i><i style="--h:70%"></i></span>
            ) : (
              <span class="orbit"><i></i><i></i><i></i></span>
            )}
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
<style>
  .parts { margin-top: 56px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .part {
    position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 10px; min-height: 380px;
    padding: 32px; border-radius: var(--radius-lg); border: 1px solid var(--line);
    background: linear-gradient(180deg, var(--panel-2), var(--panel));
    transition: border-color 0.3s, transform 0.4s var(--ease);
  }
  .part:hover { border-color: var(--line-2); transform: translateY(-3px); }
  .p0 { background: radial-gradient(90% 70% at 100% 100%, rgba(224, 122, 85, 0.16), transparent 60%), linear-gradient(180deg, var(--panel-2), var(--panel)); }
  .p1 { background: radial-gradient(90% 70% at 100% 100%, rgba(124, 140, 255, 0.16), transparent 60%), linear-gradient(180deg, var(--panel-2), var(--panel)); }
  .top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
  .n { font: 500 13px var(--mono); color: var(--dim); }
  .badge { font: 500 12px var(--mono); letter-spacing: 0.04em; text-transform: uppercase; padding: 5px 10px; border-radius: 999px; background: rgba(224, 122, 85, 0.14); color: var(--ember-2); }
  .p1 .badge { background: rgba(124, 140, 255, 0.14); color: var(--violet); }
  .label { font: 500 12px var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  h3 { margin: 0; font-size: clamp(22px, 2.4vw, 28px); font-weight: 600; letter-spacing: -0.02em; }
  p { margin: 0; color: var(--muted); max-width: 46ch; position: relative; z-index: 1; }
  .more { margin-top: auto; font-weight: 550; font-size: 14.5px; position: relative; z-index: 1; }
  .more span { display: inline-block; transition: transform 0.25s var(--ease); }
  .part:hover .more span { transform: translateX(4px); }
  .art { position: absolute; right: 28px; bottom: 28px; width: 150px; height: 110px; opacity: 0.85; }
  .bars { display: flex; align-items: flex-end; gap: 8px; height: 100%; }
  .bars i { flex: 1; height: var(--h); border-radius: 6px 6px 2px 2px; background: linear-gradient(180deg, var(--ember-2), rgba(224, 122, 85, 0.15)); transform-origin: bottom; animation: grow 3.2s var(--ease) infinite alternate; }
  .bars i:nth-child(2) { animation-delay: 0.3s; } .bars i:nth-child(3) { animation-delay: 0.6s; } .bars i:nth-child(4) { animation-delay: 0.9s; } .bars i:nth-child(5) { animation-delay: 1.2s; }
  @keyframes grow { from { transform: scaleY(0.7); } }
  .orbit { position: absolute; inset: 0; display: block; }
  .orbit i { position: absolute; border: 1px solid rgba(168, 164, 255, 0.35); border-radius: 50%; inset: 0; animation: spin 14s linear infinite; }
  .orbit i:nth-child(2) { inset: 18px 30px; animation-duration: 9s; animation-direction: reverse; }
  .orbit i:nth-child(3) { inset: 40px 62px; background: var(--violet); box-shadow: 0 0 24px var(--violet); border: 0; }
  .orbit i:nth-child(1)::after, .orbit i:nth-child(2)::after { content: ""; position: absolute; top: -4px; left: 50%; width: 8px; height: 8px; border-radius: 50%; background: var(--moss); }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (max-width: 820px) { .parts { grid-template-columns: 1fr; } .part { min-height: 340px; } .art { width: 110px; height: 80px; } }
</style>
