---
import { site } from "../site";
import type { Dict } from "../i18n/en";
import { liveSupportCopy as supportCopy } from "../lib/support-network-copy";
import "../styles/support-widget.css";
import "../styles/support-media.css";
import "../styles/support-presence.css";
import "../styles/support-orders.css";
interface Props { t: Dict }
const { t } = Astro.props;
const copy = supportCopy(t.meta.lang);
const data = { copy, lang: t.meta.lang };
---
<aside id="support-widget" class="support-widget" hidden aria-label={copy.title}>
  <button class="support-launcher" data-support-open aria-label={copy.title} aria-expanded="false" aria-controls="support-panel">
    <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 12a8 8 0 0 1 16 0v5a3 3 0 0 1-3 3h-3M4 11h3v6H4zM17 11h3v6h-3zM10 19h4v2h-4z" /></svg>
    <i class="support-launcher-state" data-support-availability-dot data-state="unknown" aria-hidden="true"></i><span class="support-launcher-label"><span>{copy.title}</span><small data-support-availability-text>{copy.availabilityUnknown}</small></span><b data-support-unread hidden></b>
  </button>
  <section id="support-panel" class="support-panel" role="dialog" aria-label={copy.title} hidden>
    <header class="support-panel-header"><div class="support-avatar" aria-hidden="true">F</div><div><h2>{copy.title}</h2><p><i data-support-availability-dot data-state="unknown" aria-hidden="true"></i><span data-support-availability-text role="status" aria-live="polite">{copy.availabilityUnknown}</span><span class="support-preview-label">{copy.demo}</span></p></div><button type="button" class="support-icon-button" data-support-close aria-label={copy.collapse}>×</button></header>
    <p class="support-demo-notice">{copy.demoNotice}</p>
    <div class="support-history-frame">
      <div class="support-history" data-support-messages role="log" tabindex="0" aria-label={copy.conversations} aria-live="polite" aria-relevant="additions text"></div>
      <button type="button" class="support-latest" data-support-latest aria-live="polite" aria-atomic="true" hidden>{copy.latest} ↓</button>
    </div>
    <div class="support-presence-slot"><div class="support-typing" data-support-typing hidden role="status" aria-live="polite"><span class="support-typing-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{copy.agentTyping}</span></div></div>
    <div class="support-session-controls" data-support-session-controls hidden><p data-support-session-notice role="status" aria-live="polite" tabindex="-1" hidden>{copy.consultationEnded}</p><button type="button" data-support-end>{copy.endConsultation}</button></div>
    <form data-support-form>
      <div class="support-attachment" data-support-preview hidden><img alt={copy.imageAlt} /><span></span><button type="button" class="support-icon-button" data-support-remove aria-label={copy.removeImage}>×</button></div>
      <label class="support-sr" for="support-text">{copy.placeholder}</label><textarea id="support-text" data-support-text placeholder={copy.placeholder} maxlength="4000" rows="2" aria-describedby="support-user-keys support-user-count support-user-error"></textarea>
      <div class="support-composer-tools"><label class="support-attach" title={copy.imageHint}><input type="file" data-support-file accept="image/png,image/jpeg,image/webp" aria-label={copy.attach} /><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 4h16v16H4zM4 16l5-5 4 4 3-3 4 4M15 8h.01" /></svg><span>{copy.attach}</span></label><button type="submit" class="support-send" data-support-send disabled><span data-support-send-label>{copy.send}</span><span aria-hidden="true">↑</span></button></div>
      <div class="support-composer-help"><span id="support-user-keys" class="support-key-hint">{copy.userKeys}</span><span id="support-user-count" data-support-character-count hidden></span></div>
      <p id="support-user-error" data-support-error class="support-form-error" role="status" aria-live="polite"></p>
    </form>
  </section>
</aside>
<aside id="support-load-fallback" class="support-load-fallback" role="status" hidden><button type="button" data-support-fallback-close aria-label={copy.collapse}>×</button><p>{copy.unavailable}</p><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></aside>
<script type="application/json" id="support-widget-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />
<script>
  document.querySelector("[data-support-fallback-close]")?.addEventListener("click", () => document.getElementById("support-load-fallback")?.setAttribute("hidden", ""));
  let started = false;
  let pendingOpen = false;
  let pendingIntent: unknown;
  let carryIntent = false;
  const start = () => {
    if (started) return;
    started = true;
    void import("../scripts/support-widget").then(() => {
      document.getElementById("support-load-fallback")?.setAttribute("hidden", "");
      document.removeEventListener("pointerdown", onIntent, true);
      document.removeEventListener("keydown", onIntent, true);
      document.removeEventListener("click", onClick, true);
      document.removeEventListener("fells:support-open", armOpen);
      if (pendingOpen) document.dispatchEvent(carryIntent
        ? new CustomEvent("fells:support-open", { detail: pendingIntent })
        : new Event("fells:support-open"));
    }).catch(() => {
      // A transient chunk fetch failure leaves every entry point available to retry.
      started = false;
      if (pendingOpen) document.getElementById("support-load-fallback")?.removeAttribute("hidden");
    });
  };
  const armOpen = (event: Event) => {
    pendingOpen = true;
    carryIntent = event instanceof CustomEvent;
    pendingIntent = carryIntent ? (event as CustomEvent).detail : undefined;
    start();
  };
  // Pointer/keyboard intent only preloads. Opening on pointerdown could cause
  // the following real click to toggle an already-open panel closed again.
  const onIntent = () => start();
  const onClick = (event: Event) => {
    const target = event.target instanceof Element ? event.target.closest<HTMLElement>("[data-support-open], [data-open-customer-support]") : null;
    if (!target) return;
    pendingOpen = true;
    carryIntent = target.hasAttribute("data-open-customer-support");
    pendingIntent = carryIntent ? { title: target.dataset.supportTitle ?? "", product: target.dataset.supportProduct ?? "", poolId: Number(target.dataset.supportPool), amountMicro: Number(target.dataset.supportAmount), publicCode: target.dataset.supportCode, serviceDays: Number(target.dataset.supportDays) } : undefined;
    start();
  };
  document.addEventListener("pointerdown", onIntent, true);
  document.addEventListener("keydown", onIntent, true);
  document.addEventListener("click", onClick, true);
  document.addEventListener("fells:support-open", armOpen);
  if (window.requestIdleCallback) window.requestIdleCallback(() => start(), { timeout: 2000 });
  else window.setTimeout(start, 2000);
</script>

<style>
  .support-load-fallback { position: fixed; right: 20px; bottom: 20px; z-index: 90; width: min(340px, calc(100vw - 40px)); box-sizing: border-box; padding: 22px; border: 1px solid var(--line, #d2d2d7); border-radius: 20px; background: var(--bg, #fff); color: var(--text, #1d1d1f); box-shadow: 0 12px 40px #0002; }
  .support-load-fallback[hidden] { display: none; }
  .support-load-fallback p { margin: 0 22px 12px 0; font-size: 14px; line-height: 1.6; }
  .support-load-fallback > button { position: absolute; top: 12px; right: 12px; border: 0; border-radius: 50%; background: transparent; color: inherit; width: 28px; height: 28px; cursor: pointer; }
  .support-load-fallback a { color: inherit; overflow-wrap: anywhere; }
</style>
