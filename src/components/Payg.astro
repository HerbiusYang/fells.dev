---
import type { Dict } from "../i18n/en";
import { link } from "../i18n/index";
import { publicCatalogWordsOf } from "../i18n/public-catalog";
import PublicCatalog from "./PublicCatalog.astro";
interface Props { t: Dict }
const { t } = Astro.props;
const words = publicCatalogWordsOf(t.meta.lang);
---
<section class="section payg" id="payg">
  <div class="wrap">
    <div class="reveal"><span class="kicker">{t.payg.kicker}</span><h2 class="h2">{words.models}</h2><p class="lead">{words.intro}</p></div>
    <div class="catalog-space"><PublicCatalog t={t} kind="models" /></div>
    <a class="market-link" href={link(t, "market")}>{t.payg.marketCta} →</a>
  </div>
</section>
<style>
  .catalog-space { margin-top: 32px; }
  .market-link { display: inline-flex; margin-top: 24px; color: var(--muted); text-decoration: underline; text-underline-offset: 4px; font-size: 14px; }
  .market-link:hover { color: var(--ink); }
</style>
