---
import { agentMarks } from "../data/icons";
import type { Dict } from "../i18n/en";
interface Props { t: Dict }
const { clients: c } = Astro.props.t;
// The Fells app card carries the Sunrise mark itself; the others use vendor marks.
const sunrise = `<svg viewBox="0 0 64 64" width="26" height="26" aria-hidden="true"><defs><linearGradient id="fells-sun-client" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffd0b5"/><stop offset=".55" stop-color="#f3a37f"/><stop offset="1" stop-color="#e07a55"/></linearGradient></defs><path d="M3.2 42 A30 30 0 1 1 60.8 42 L44 26 L33 37 L21 22 Z" fill="url(#fells-sun-client)" stroke="url(#fells-sun-client)" stroke-width="2" stroke-linejoin="round"/></svg>`;
const marks = [sunrise, agentMarks.claude.svg, agentMarks.codex.svg, agentMarks.opencode.svg];
const hues = ["#3a3f4b", "#e07a55", "#7c8cff", "#9aa4b2"];
---
<section class="section clients">
  <div class="wrap">
    <div class="reveal">
      <span class="kicker">{c.kicker}</span>
      <h2 class="h2">{c.title}</h2>
    </div>
    <div class="grid">
      {c.items.map((it, i) => (
        <article class:list={["item reveal", { home: i === 0 }]} style={`--hue:${hues[i]};transition-delay:${i * 70}ms`}>
          <span class="mark" aria-hidden="true"><Fragment set:html={marks[i]} /></span>
          <h3>{it.name}</h3>
          <p>{it.detail}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .clients { padding-top: 40px; }
  .grid { margin-top: 48px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .item { padding: 24px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--panel); transition: border-color 0.3s, transform 0.3s var(--ease); }
  .item:hover { border-color: var(--line-2); transform: translateY(-2px); }
  .home { border-color: rgba(243, 163, 127, 0.35); background: radial-gradient(100% 80% at 0% 0%, rgba(224, 122, 85, 0.14), transparent 60%), var(--panel); }
  .mark { width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; font-weight: 700; font-size: 18px; color: #fff; background: color-mix(in oklab, var(--hue) 65%, #1a1d25); }
  h3 { margin: 18px 0 6px; font-size: 17px; font-weight: 600; }
  p { margin: 0; color: var(--muted); font-size: 14px; }
  @media (max-width: 960px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .grid { grid-template-columns: 1fr; } }
</style>
