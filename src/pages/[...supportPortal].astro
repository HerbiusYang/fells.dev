---
import type { Dict } from "../i18n/en";
import { locales } from "../i18n/index";
import SupportPage from "../components/pages/SupportPage.astro";

export function getStaticPaths() {
  return locales.flatMap(locale => {
    const entry = locale.path.slice(1) + "support";
    return [
      { params: { supportPortal: entry }, props: { t: locale.t } },
      { params: { supportPortal: `${entry}/desk` }, props: { t: locale.t } },
    ];
  });
}
interface Props { t: Dict }
const { t } = Astro.props;
---
<SupportPage t={t} />
