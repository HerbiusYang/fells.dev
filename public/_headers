# Applied by static hosts that support _headers (for example Cloudflare Pages / Netlify).
# These hosts must terminate HTTPS. Other hosts must set equivalent response
# headers; see README. Built script hashes are generated in each page's CSP meta.
/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

# HTML documents. `/` is only the homepage; `/*/` is every other trailing-slash route.
# These two patterns do not overlap, so Cache-Control is not comma-joined.
/
  Cache-Control: public, max-age=0, s-maxage=3600

/*/
  Cache-Control: public, max-age=0, s-maxage=3600

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/favicon-32.png
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/og.png
  Cache-Control: public, max-age=31536000, immutable

# The edge serves this route directly; prevent stale maintenance state if a
# static host supplies a fallback response during configuration changes.
/__maintenance/status
  Cache-Control: no-store, max-age=0
