{
  "name": "fells-dev",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.test.mjs",
    "test:all": "node scripts/test-all.mjs",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test:coverage": "node scripts/test-all.mjs --coverage",
    "check:unused": "knip && knip --production --strict"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "fake-indexeddb": "^6.2.5",
    "knip": "^6.40.0",
    "playwright": "1.62.1",
    "typescript": "^6.0.3"
  }
}
